]
BLOCKER_DETAILS = {
    "accepted-runtime-command-compatibility":
        "Source interfaces mapped at 04ad0aa; accepted ARM artifact/version/help still absent.",
    "daemon-bridge-provider-negative-access":
        "Disposable bwrap probes pass; real provider contained preparation/verification/output custody "
        "and confirmed stop integration remain incomplete in mapped docs/worker-operations.md.",
    "private-provider-auth-refresh-and-repository-auth":
