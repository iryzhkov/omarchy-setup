#!/usr/bin/env bash
# Regenerate the shared agent instruction files under ~/.config/agents/ from this
# repository.
#
#   AGENTS.md     <- the pointer text embedded below; installed for Codex and OpenCode
#   ov-memory.md  <- config/claude/skills/ov-memory/SKILL.md
#                    + config/claude/skills/ov-memory-curation/SKILL.md
#   huyang.md     <- the "# Reading and editing code" section of config/claude/CLAUDE.md
#                    + config/claude/skills/huyang/SKILL.md
#   t3-steward.md <- config/claude/skills/t3-task/SKILL.md
#                    + config/claude/skills/t3-campaign/SKILL.md
#                    + config/claude/skills/t3-wait/SKILL.md
#   t3-campaign-executor-briefs.md <- t3-campaign/references/executor-briefs.md
#   jocasta.md    <- the "# Working documents: Jocasta" section of the same CLAUDE.md
#
# Only AGENTS.md is loaded into every session of the harnesses that do not read
# ~/.claude/CLAUDE.md: it is written into ~/.codex/AGENTS.md inside a managed block and is
# the single entry of OpenCode's instructions list. The other files are references those
# summaries point at, read when a task needs them, the way a skill is. UpKeeper projects
# repository-owned skills to the harness discovery roots; this generator neither installs
# nor publishes skills.
#
# Every source is read from the checkout and never from $HOME. Reading the installed
# copies is how a hand-edit on one host used to be laundered into these generated files,
# captured into an UpKeeper release and published to the fleet without anyone reviewing
# it. There is therefore no fallback to $HOME: when the checkout cannot be found this
# script fails and changes nothing.
#
# Which file is authoritative for which installed artifact, which module installs it, and
# what to do when a host has diverged: docs/agent-instruction-ownership.md.
set -euo pipefail

program=${0##*/}
die() {
  printf '%s: %s\n' "$program" "$*" >&2
  exit 1
}

usage() {
  cat <<'USAGE'
Usage: agents-instructions-gen [--root DIR] [--policy FILE] [--check]

Generate ~/.config/agents/ from an omarchy-setup checkout. The checkout is the only
source; nothing is ever read back out of $HOME.

  --root DIR  The checkout to read. Default: $OMARCHY_SETUP_ROOT, else the checkout this
              script is running from. A copy installed in ~/.local/bin is not in a
              checkout, so it needs one of the two.
  --policy FILE  Explicit reviewed route-policy/v1 input; parsed by t3-steward policy
                 show --file FILE --json. Never discovered under HOME. Native roles
                 require this option; without it legacy generation remains compatible.
  --check     Change nothing. Compare the installed copies against what this checkout
              says they should be, and report every path that differs and in which
              direction. Exit 0 when the host matches, 3 when it has diverged, 1 on an
              error, so a person can read the report on a host that is deliberately
              behind while CI can treat any divergence as a failure.
  -h, --help  Show this help.
USAGE
}

root=''
root_source=''
mode=install
policy=''
while (($#)); do
  case $1 in
  --root)
    (($# >= 2)) || die "--root needs a value"
    root=$2
    root_source='--root'
    shift 2
    ;;
  --root=*)
    root=${1#--root=}
    root_source='--root'
    shift
    ;;
  --policy)
    if (($# < 2)); then
      die "--policy needs a nonempty file"
    fi
    [[ -n $2 ]] || die "--policy needs a nonempty file"
    [[ -z $policy ]] || die "--policy supplied twice"
    policy=$2
    shift 2
    ;;
  --policy=*)
    [[ -z $policy && -n ${1#--policy=} ]] || die "--policy needs one nonempty file"
    policy=${1#--policy=}
    shift
    ;;
  --check)
    mode=check
    shift
    ;;
  -h | --help)
    usage
    exit 0
    ;;
  *) die "unknown option: $1 (try --help)" ;;
  esac
done

# ------------------------------------------------------------------- root --
# Three ways to name the checkout, tried in order, and no fourth. The failure names every
# path it looked for, because the alternative -- guessing at $HOME -- is the defect this
# script was rewritten to remove.
if [[ -z $root ]]; then
  if [[ -n ${OMARCHY_SETUP_ROOT:-} ]]; then
    root=$OMARCHY_SETUP_ROOT
    root_source='$OMARCHY_SETUP_ROOT'
  else
    self=$(readlink -f "${BASH_SOURCE[0]}")
    root=$(cd "$(dirname "$self")/../.." >/dev/null 2>&1 && pwd) || root=''
    root_source="the checkout containing $self"
  fi
fi

root=${root%/}
claude_source="$root/config/claude/CLAUDE.md"
skills_source="$root/config/claude/skills"
if [[ -z $root || ! -f $claude_source || ! -d $skills_source ]]; then
  die "no omarchy-setup checkout at '$root' (from $root_source): expected $claude_source
and $skills_source. Pass --root DIR or set OMARCHY_SETUP_ROOT. This script never falls
back to reading \$HOME, because a host-local copy is not a source."
fi

# The skills this script concatenates. A checkout missing one of them would silently
# produce a reference file with a hole in it.
required_skills=(ov-memory ov-memory-curation huyang t3-task t3-campaign t3-wait)
missing=()
for name in "${required_skills[@]}"; do
  [[ -f "$skills_source/$name/SKILL.md" ]] || missing+=("$skills_source/$name/SKILL.md")
done
campaign_briefs="$skills_source/t3-campaign/references/executor-briefs.md"
[[ -f $campaign_briefs ]] || missing+=("$campaign_briefs")
((${#missing[@]} == 0)) || die "the checkout at $root is missing: ${missing[*]}"

strip_frontmatter() { awk 'NR==1 && /^---$/ {skip=1; next} skip && /^---$/ {skip=0; next} !skip' "$1"; }

# ------------------------------------------------------------- generation --
# Everything is written into a staging directory first, so --check can compare without
# touching anything and an install is a copy of a complete set rather than five
# half-finished writes.
stage=$(mktemp -d)
trap 'rm -rf "$stage"' EXIT

cat >"$stage/AGENTS.md" <<'AGENTS'
# Global agent instructions

The shared instructions for the harnesses that do not read ~/.claude/CLAUDE.md. Generated
by `agents-instructions-gen` from omarchy-setup's config/bin/agents-instructions-gen; edit
it there and regenerate rather than editing an installed copy.

Each section below is a summary. The full guidance lives in a skill, loaded on demand from
~/.claude/skills, and in the generated reference files under ~/.config/agents/, which are
read when a task needs them rather than loaded into every session.

## OV memory

This machine's agents share a long-term memory store (OpenViking on homelab), reached
through the `ov-memory` MCP server. Search it before answering questions about past work,
infrastructure or decisions; write to it only when asked. Record the fact and why it is
true; store a pointer to a credential, never the secret.

Namespaces, document shape and curation: the `ov-memory` and `ov-memory-curation` skills,
or **~/.config/agents/ov-memory.md**.

## Reading and editing code

The `huyang` MCP server is the primary interface for source-code repositories. Call
`workspace_open` for the repository root first, retain its workspace ID and revision, then
use Huyang's semantic reads and transactional edits. No harness preference for shell file
tools overrides this for a path inside a repository. The shell runs only Git, builds and
tests, other programs whose output is the point, and searches across directories that are
not one repository.

A result is valid only for the revision it names. Fix a refusal for a stale revision,
conflict or incomplete evidence rather than bypassing it with an unguarded overwrite.

Tool mapping, the cheapest correct call for each need, and the evidence rules: the
`huyang` skill, or **~/.config/agents/huyang.md**.

## Publish validated agent-tooling changes

When working on agent tooling (Huyang, t3-steward, UpKeeper, agent99, shared
AGENTS.md/CLAUDE.md files, skills or MCP configuration), finish a validated fix through
UpKeeper without waiting for a separate request to push: validate and publish the source,
confirm exact source CI, then review and publish the full release. Use ordinary
`upkeeper push` only when intentionally capturing the validated host. For a prepared
release, obtain its canonical digest from read-only `upkeeper fleet-plan --json` and use
`upkeeper push --authored --expect-head SHA --expect-release-sha256 DIGEST`; authored
mode preserves reviewed bytes and does not recapture the host. Before release publication, inspect holds and preview full target drift because timers may
converge automatically; preserve an unpublished candidate when that preview is unsafe.
Confirm release CI before any later convergence. Report source publication, release publication and verified deployment separately.
For instructions, edit owning sources and regenerate derived files. An explicit user
instruction to keep work local takes precedence.

The whole procedure: the `publish-agent-tooling` skill.

## Local file LLM

The `local-file-llm` MCP server delegates bulk file reading and summarising to a local
model on gaming-pc (ollama at 192.168.90.212). Use it for work that is large but not
subtle: scanning many files for a pattern, first-pass summaries, log triage. Keep
judgement calls here.

## Interactive work and the T3 steward

Read the matching skill, or ~/.config/agents/t3-steward.md, before its first command.

Stay interactive while exploring, designing, answering contract questions and making
decisions turn by turn. Hand off to a campaign once Igor has agreed a plan; never
submit exploration that is not yet a plan. Use a subagent for quick same-provider
reading or sub-work inside either an interactive session or a steward task.
Subagents are never in place of a declared task or review.

Agree the plan, write it to Jocasta, turn it into a campaign with the
`t3-campaign` skill, and submit with the session as notify thread
(`--notify-thread current`). Once Igor has agreed the plan in the session,
agents may submit it without another approval: say that the campaign started and
give the run id and ledger reference. Ask first when the estimated cost is large,
the work needs operator-level access, or it releases to the fleet. After handoff,
keep only the run id and Jocasta ledger reference in the session's working set;
fetch detailed evidence when needed.

Model roles are assigned by hand until a generated policy replaces them:
Opus 5.5 or Sol 6.1 at high effort for planning and execution; Fable 5.1 or Astra
at medium effort for critical review, including plan review; Sonnet 5.5 or Luna 6
at medium effort for reading. Never use max effort or above. Check
`t3-steward models` for available routes; role names are guidance, not CLI flags.
In Claude Code, bulk reading (many files, long logs, large diffs or codebase
searches) goes to a reader subagent (`model: sonnet`) with a focused question and
a bounded answer. Codex sessions use Luna 6 (`codex/gpt-6-luna`) at medium effort for the same.
Read a quick lookup in a known file directly.

Inside a steward task, `t3-steward ask` is the one way to get a decision from Igor:
give options, a deadline and a safe default, end the turn after parking, and read
`ask-answer.json` on resume. Approver-required asks take no default and fail
unanswered. Outside a task, use the session's own question tool.
Use `t3-steward review` for cross-provider plan or diff review; the
`t3-campaign` skill describes file inputs and the review digestion loop.

- **One task** (`t3-task` skill): one independent unattended outcome uses
  `t3-steward task run --model [INSTANCE/]MODEL -- "<prompt>"` from a checkout.
  Use `--input FILE` for pinned inputs and `--dry-run` before submission.
  The start is synchronous; a refusal is its exit code. Take the run id from
  the first line (`run <id>`) or JSON, never from the closing result command.
  Follow the record's closing instruction: end the turn only when it promises
  a wake; collect immediately when the run already ended.
- **Campaign** (`t3-campaign` skill): dependent tasks, artifact handoffs,
  declared reviews and recurring schedules use a version 2 workflow directory.
  Run `campaign validate`, `campaign plan` and read-only `campaign check`;
  submit with an idempotency key and the session as notify thread.
  Tasks keep `continuation.md` current; details and the milestone ledger template
  live in the skill. A caller intentionally wanting no wake uses `--no-notify`;
  unresolved notify threads are refused before submission.
- **Wait** (`t3-wait` skill): use a foreground blocking command such as
  `t3-steward task result <run> --wait` or `campaign show <run> --wait` in a plain CLI.
  In a steward task, register `wait add --task current` for external waits and
  end the turn immediately. Conditions are `--at`/`--for` time, `--github`,
  `--node`, `--quota`, or `-- COMMAND` (0 met, 2 give up, else not yet).
  `--or-timeout` makes a deadline an outcome. Ordinary sessions register a
  thread wait and end the turn. Never poll in an agent loop.
  Use `t3-steward triage` for operator attention and ready-to-run recovery commands.

## Shared working documents

Use Jocasta for shared plans, handoffs and research. Search with `jocasta search`, fetch
the full document before an update, and use `--if-revision N`. Read
**~/.config/agents/jocasta.md** before creating or changing documents.
AGENTS

{
  cat <<'HDR'
# OV memory (shared agent instructions)

Generated from omarchy-setup's config/claude/skills/ov-memory{,-curation}/SKILL.md,
which are the source of truth. Edit the skill in that repository and regenerate
with `agents-instructions-gen`; do not edit this file directly.

HDR
  strip_frontmatter "$skills_source/ov-memory/SKILL.md"
  echo; echo '---'; echo
  strip_frontmatter "$skills_source/ov-memory-curation/SKILL.md"
} >"$stage/ov-memory.md"

{
  cat <<'HDR'
# T3 steward: tasks, campaigns and wait (shared agent instructions)

Generated from omarchy-setup's config/claude/skills/t3-task/SKILL.md,
config/claude/skills/t3-campaign/SKILL.md and config/claude/skills/t3-wait/SKILL.md,
which are the source of truth and are also what ~/.claude/skills/ holds. Edit the
skill in that repository, then regenerate with `agents-instructions-gen`; do not
edit this file directly.

One rule is worth reading twice. Inside any running Steward task,
`t3-steward wait add --task current -- <command>` parks the task attempt itself: nothing is
collected, nothing is verified and the run cannot settle until the steward resumes the same
thread. End the turn the moment it registers. An interactive wait, registered outside a task,
only wakes a thread and changes no workflow state.

An interactive wait can resolve the current T3 thread from supported Claude Code, Codex
and OpenCode session metadata. If resolution is unavailable, pass `--thread <id>` using
the thread URL shown by the T3 app. A provider-local session id is not a T3 thread id.
Inside a task the execution identity is injected and `--task current` resolves it.

HDR
  strip_frontmatter "$skills_source/t3-task/SKILL.md"
  echo; echo '---'; echo
  # The skill's relative link is correct in its installed directory. The shared
  # concatenated reference has a different parent, so rewrite only that target.
  strip_frontmatter "$skills_source/t3-campaign/SKILL.md" |
    sed 's#](references/executor-briefs.md)#](t3-campaign-executor-briefs.md)#g'
  echo; echo '---'; echo
  strip_frontmatter "$skills_source/t3-wait/SKILL.md"
} >"$stage/t3-steward.md"
cp "$campaign_briefs" "$stage/t3-campaign-executor-briefs.md"

{
  cat <<'HDR'
# Huyang: reading and editing code (shared agent instructions)

Generated from the "Reading and editing code" section of omarchy-setup's
config/claude/CLAUDE.md and from its config/claude/skills/huyang/SKILL.md, which are
the sources of truth. Edit them in that repository and regenerate with
`agents-instructions-gen`; do not edit this file directly.

Tool names below are Huyang's modern MCP surface and are shared by every harness.

HDR
  awk '/^# Reading and editing code$/ {p=1} p' "$claude_source"
  echo; echo '---'; echo
  strip_frontmatter "$skills_source/huyang/SKILL.md"
} >"$stage/huyang.md"

{
  echo '# Jocasta: shared working documents'
  echo
  echo "Generated from the Working documents: Jocasta section of omarchy-setup's"
  echo 'config/claude/CLAUDE.md. Edit it there and run agents-instructions-gen.'
  echo
  # The source paragraph points readers at this file; inside it that pointer is noise.
  # The pattern omits the leading tilde so that no shell expansion is implied.
  awk '/^# Working documents: Jocasta$/ {p=1; next} p && /^# / {exit} p' \
    "$claude_source" | grep -v '/.config/agents/jocasta.md' || true
} >"$stage/jocasta.md"

if [[ -n $policy ]]; then
  python3 "$root/config/bin/agents-role-project" "$root" "$stage" "$policy" "$mode"
  exit $?
fi

# Validate and stage both fence intervals before check or any installed write.
# Keep the no-policy generator standalone, including its installed/copied entry point.
python3 - "$stage" <<'PY'
import os
from pathlib import Path
import sys

def validate(text):
    intervals = []
    for name in ("fleet", "jocasta"):
        first, last = f"<!-- {name}:start -->", f"<!-- {name}:end -->"
        if first in text or last in text:
            if text.count(first) != 1 or text.count(last) != 1 or text.index(last) < text.index(first):
                raise SystemExit("malformed instruction block")
            intervals.append((text.index(first), text.index(last) + len(last)))
    intervals.sort()
    if len(intervals) == 2 and intervals[0][1] > intervals[1][0]:
        raise SystemExit("overlapping instruction blocks")

stage = Path(sys.argv[1])
path = Path.home() / ".codex/AGENTS.md"
text = path.read_text() if path.exists() else ""
validate(text)
start, end = "<!-- fleet:start -->", "<!-- fleet:end -->"
legacy_start, legacy_end = "<!-- jocasta:start -->", "<!-- jocasta:end -->"
if legacy_start in text:
    text = (text[:text.index(legacy_start)].rstrip() + "\n"
            + text[text.index(legacy_end) + len(legacy_end):].lstrip())
block = start + "\n" + (stage / "AGENTS.md").read_text().strip() + "\n" + end
if start in text:
    text = text[:text.index(start)] + block + text[text.index(end) + len(end):]
else:
    text = (text.rstrip() + "\n\n" + block + "\n").lstrip()
validate(text)
(stage / "codex-merged").write_text(text)
PY

# ------------------------------------------------------------------ check --
# A report, not a repair: --check writes nothing anywhere. It verifies the resident
# instruction artifacts generated by this checkout. Skills are source-projected by
# UpKeeper and are deliberately outside this setup-script check.
if [[ $mode == check ]]; then
  diverged=0
  report() {
    printf '  %s\n' "$*"
    diverged=1
  }
  # Installed paths are printed home-relative, which is how a person refers to them.
  tilde='~'
  pretty() { printf '%s' "${1/#$HOME/$tilde}"; }
  compare() { # compare <wanted file> <installed file> [what produces the wanted file]
    local want=$1 have=$2 origin=${3:-${1#"$root"/}} label
    label=$(pretty "$have")
    if [[ ! -f $have ]]; then
      report "$label: absent on this host; $origin would install it"
    elif ! cmp -s "$want" "$have"; then
      report "$label: the host copy differs from $origin"
    fi
  }

  printf '%s: checking this host against %s\n' "$program" "$root"

  compare "$claude_source" "$HOME/.claude/omarchy-setup/CLAUDE.md"

  # ~/.config/agents is generated whole, so a file in it that nothing generates is a
  # leftover and is reported as one.
  for generated in "$stage"/*.md; do
    name=$(basename "$generated")
    compare "$generated" "$HOME/.config/agents/$name" "what this checkout generates"
  done
  for installed in "$HOME"/.config/agents/*.md; do
    [[ -f $installed ]] || continue
    name=$(basename "$installed")
    [[ -f "$stage/$name" ]] ||
      report "$(pretty "$installed"): present on this host and generated by nothing"
  done

  # The Codex copy is the same bytes inside a fence, so it diverges on its own.
  codex="$HOME/.codex/AGENTS.md"
  if [[ -f $codex ]]; then
    have_block=$(awk '/^<!-- fleet:start -->$/ {p=1; next} /^<!-- fleet:end -->$/ {p=0} p' "$codex")
    want_block=$(cat "$stage/AGENTS.md")
    if [[ -z $have_block ]]; then
      report "$(pretty "$codex"): no <!-- fleet:start --> block, so Codex reads none of this"
    elif [[ $have_block != "$want_block" ]]; then
      report "$(pretty "$codex"): the fleet block differs from the generated AGENTS.md"
    fi
  fi

  if ((diverged)); then
    cat <<EOF
$program: this host has diverged from $root.
The repository is authoritative. Converge the host with
  $root/run.sh   (or: $program --root $root)
and never by editing an installed copy: the next convergence overwrites it, and an
UpKeeper capture taken from this host would publish it to the whole fleet.
EOF
    exit 3
  fi
  printf '%s: the installed agent instructions match %s\n' "$program" "$root"
  exit 0
fi

# ---------------------------------------------------------------- install --
out="$HOME/.config/agents"
mkdir -p "$out"
for generated in "$stage"/*.md; do
  install -m 0644 "$generated" "$out/$(basename "$generated")"
done

# The managed pointer block is generated, while unrelated global instructions remain intact,
# and OpenCode is pointed at the one shared file instead of the reference set.
python3 - "$stage/codex-merged" <<'PY'
import json
import os
import sys
from pathlib import Path
home = Path.home()
shared = home / ".config/agents/AGENTS.md"
path = home / ".codex/AGENTS.md"
text = Path(sys.argv[1]).read_text()
path.parent.mkdir(parents=True, exist_ok=True)
path.write_text(text)
opencode = home / ".config/opencode/opencode.json"
if opencode.exists():
    config = json.loads(opencode.read_text())
    instructions = config.setdefault("instructions", [])
    if not isinstance(instructions, list):
        raise SystemExit("OpenCode instructions must be a list")
    # The reference files are read on demand, so only the shared pointer is loaded into
    # every session. Entries from elsewhere are the user's own and are preserved.
    managed = {str(home / ".config/agents" / name) for name in (
        "AGENTS.md", "ov-memory.md", "huyang.md", "t3-steward.md",
        "t3-campaign-executor-briefs.md", "jocasta.md", "agent99.md")}
    kept = [entry for entry in instructions if str(entry) not in managed]
    wanted = [str(shared)] + kept
    if instructions != wanted:
        config["instructions"] = wanted
        mode = opencode.stat().st_mode & 0o777
        temporary = opencode.with_suffix(".agents.tmp")
        fd = os.open(temporary, os.O_WRONLY | os.O_CREAT | os.O_EXCL, mode)
        with os.fdopen(fd, "w") as handle:
            json.dump(config, handle, indent=2)
            handle.write("\n")
        temporary.replace(opencode)
PY

rm -f "$out/agent99.md"
echo "wrote $out/AGENTS.md $out/ov-memory.md $out/huyang.md $out/t3-steward.md $out/jocasta.md (from $root)"
