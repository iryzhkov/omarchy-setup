#!/usr/bin/env bash
# Regenerate the shared agent instruction files under ~/.config/agents/ from their sources.
#
#   ov-memory.md  <- ~/.claude/skills/ov-memory/SKILL.md + ~/.claude/skills/ov-memory-curation/SKILL.md
#   agent99.md    <- the "# Reading and editing code" section of ~/.claude/omarchy-setup/CLAUDE.md
#   t3-steward.md <- ~/.claude/skills/t3-backlog/SKILL.md + ~/.claude/skills/t3-wait/SKILL.md
#
# These files are what OpenCode (and any other non-Claude-Code agent) loads as instructions,
# because those tools do not read ~/.claude/CLAUDE.md. Run after editing a source.
set -euo pipefail
out="$HOME/.config/agents"
mkdir -p "$out"

strip_frontmatter() { awk 'NR==1 && /^---$/ {skip=1; next} skip && /^---$/ {skip=0; next} !skip' "$1"; }

{
  cat <<'HDR'
# OV memory (shared agent instructions)

Generated from ~/.claude/skills/ov-memory{,-curation}/SKILL.md, which are the
source of truth. Regenerate with `agents-instructions-gen` after editing those;
do not edit this file directly.

HDR
  strip_frontmatter "$HOME/.claude/skills/ov-memory/SKILL.md"
  echo; echo '---'; echo
  strip_frontmatter "$HOME/.claude/skills/ov-memory-curation/SKILL.md"
} > "$out/ov-memory.md"

{
  cat <<'HDR'
# T3 steward: backlog and wait (shared agent instructions)

Generated from ~/.claude/skills/t3-backlog/SKILL.md and ~/.claude/skills/t3-wait/SKILL.md,
which are the source of truth. Regenerate with `agents-instructions-gen` after editing
those; do not edit this file directly.

Two things the t3-steward daemon does for agents on these machines. Backlog: work that
does not need the user now is queued with `t3-backlog` and runs as an unattended T3 thread
in a quiet slot with quota headroom. Wait: never poll in a loop for something external;
register the check with `t3-steward wait add -- <command>`, end the turn, and the steward
wakes the thread with the outcome. Both need the T3 thread id when the agent is not Claude
Code: pass `--thread <id>`; the id is in the thread URL shown by the T3 app.

HDR
  strip_frontmatter "$HOME/.claude/skills/t3-backlog/SKILL.md"
  echo; echo '---'; echo
  strip_frontmatter "$HOME/.claude/skills/t3-wait/SKILL.md"
} > "$out/t3-steward.md"

{
  cat <<'HDR'
# agent99: reading and editing code (shared agent instructions)

Generated from the "Reading and editing code" section of
~/.claude/omarchy-setup/CLAUDE.md, which is the source of truth. Regenerate with
`agents-instructions-gen` after editing it; do not edit this file directly.

Tool names below are Claude Code's. In OpenCode the equivalents are `read`, `edit`,
`write`, `grep`, `glob` and `bash`; the rule is the same: for source code in an open
agent99 workspace, use the agent99 tools instead.

HDR
  awk '/^# Reading and editing code$/ {p=1} p' "$HOME/.claude/omarchy-setup/CLAUDE.md"
} > "$out/agent99.md"

echo "wrote $out/ov-memory.md $out/agent99.md $out/t3-steward.md"
