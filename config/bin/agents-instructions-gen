#!/usr/bin/env bash
# Regenerate the shared agent instruction files under ~/.config/agents/ from their sources.
#
#   ov-memory.md  <- ~/.claude/skills/ov-memory/SKILL.md + ~/.claude/skills/ov-memory-curation/SKILL.md
#   huyang.md     <- the "# Reading and editing code" section of ~/.claude/omarchy-setup/CLAUDE.md
#   t3-steward.md <- ~/.claude/skills/t3-backlog/SKILL.md + ~/.claude/skills/t3-campaign/SKILL.md
#                    + ~/.claude/skills/t3-wait/SKILL.md
#
# These files are what OpenCode (and any other non-Claude-Code agent) loads as instructions,
# because those tools do not read ~/.claude/CLAUDE.md. Run after editing a source.
#
# The installed skills read below are copies of this repository's own
# config/claude/skills/<name>/SKILL.md, which is where a skill is edited. Editing the
# installed copy loses the change the next time the host converges.
set -euo pipefail
out="$HOME/.config/agents"
mkdir -p "$out"

strip_frontmatter() { awk 'NR==1 && /^---$/ {skip=1; next} skip && /^---$/ {skip=0; next} !skip' "$1"; }

{
  cat <<'HDR'
# OV memory (shared agent instructions)

Generated from ~/.claude/skills/ov-memory{,-curation}/SKILL.md, which are the
source of truth. Regenerate with `agents-instructions-gen` after editing those;
do not edit this file directly.

HDR
  strip_frontmatter "$HOME/.claude/skills/ov-memory/SKILL.md"
  echo; echo '---'; echo
  strip_frontmatter "$HOME/.claude/skills/ov-memory-curation/SKILL.md"
} > "$out/ov-memory.md"

{
  cat <<'HDR'
# T3 steward: backlog, campaigns and wait (shared agent instructions)

Generated from ~/.claude/skills/t3-backlog/SKILL.md, ~/.claude/skills/t3-campaign/SKILL.md
and ~/.claude/skills/t3-wait/SKILL.md, which are installed copies of
omarchy-setup's config/claude/skills/<name>/SKILL.md. Edit the skill in that repository,
then regenerate with `agents-instructions-gen`; do not edit this file directly.

Three things the t3-steward daemon does for agents on these machines. Backlog: one piece of
work that does not need the user now is queued with `t3-backlog` and runs as an unattended
T3 thread in a quiet slot with quota headroom. Campaign: work that is more than one task, or
whose tasks depend on each other or pass files between them, is written as a directory and
submitted with `t3-steward campaign submit`, which creates exactly one workflow run. Wait:
never poll in a loop for something external; register the check with
`t3-steward wait add -- <command>`, end the turn, and the steward wakes the thread with the
outcome.

One rule is worth reading twice. Inside a running backlog or campaign task,
`t3-steward wait add --task current -- <command>` parks the task attempt itself: nothing is
collected, nothing is verified and the run cannot settle until the steward resumes the same
thread. End the turn the moment it registers. An interactive wait, registered outside a task,
only wakes a thread and changes no workflow state.

An interactive wait can resolve the current T3 thread from supported Claude Code, Codex
and OpenCode session metadata. If resolution is unavailable, pass `--thread <id>` using
the thread URL shown by the T3 app. A provider-local session id is not a T3 thread id.
Inside a task the execution identity is injected and `--task current` resolves it.

HDR
  strip_frontmatter "$HOME/.claude/skills/t3-backlog/SKILL.md"
  echo; echo '---'; echo
  strip_frontmatter "$HOME/.claude/skills/t3-campaign/SKILL.md"
  echo; echo '---'; echo
  strip_frontmatter "$HOME/.claude/skills/t3-wait/SKILL.md"
} > "$out/t3-steward.md"

{
  cat <<'HDR'
# Huyang: reading and editing code (shared agent instructions)

Generated from the "Reading and editing code" section of
~/.claude/omarchy-setup/CLAUDE.md, which is the source of truth. Regenerate with
`agents-instructions-gen` after editing it; do not edit this file directly.

Tool names below are Huyang's modern MCP surface and are shared by every harness.

HDR
  awk '/^# Reading and editing code$/ {p=1} p' "$HOME/.claude/omarchy-setup/CLAUDE.md"
} > "$out/huyang.md"

rm -f "$out/agent99.md"
echo "wrote $out/ov-memory.md $out/huyang.md $out/t3-steward.md"
