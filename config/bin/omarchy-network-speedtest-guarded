#!/bin/bash

# Hardened drop-in for omarchy-network-speedtest, used by the igor.speedtest
# panel clone. Same stdout contract: one Mbps figure per line until it stops.
#
# WHAT ACTUALLY RUNS AWAY
# The stock script forks `parallel` (8) background copies of traffic_worker.
# Those are subshells, so they inherit the parent's cmdline verbatim -- in ps
# they look like 8 separate invocations of the script, which is misleading.
# Each loops `while true` on curl and has no exit condition of its own.
#
# The main process cleans them up from its EXIT trap, but that only helps when
# the trap gets to run. If the main process is SIGKILLed -- which is what the
# shell does when a SIGTERM isn't acknowledged quickly enough -- the 8 workers
# survive, get adopted by systemd --user, and saturate the link forever. That
# is the observed failure: 8 orphans at 60+ MB/s with the parent long gone.
#
# So every guard below lives in the WORKER, not just the parent. A worker must
# be able to end itself with no help from anything else.

set -e

direction="${1:-}"
probe=1.1.1.1
parallel=8
url_count=3

# The panel's phaseTimer stops each phase at 5s, so anything beyond this is a
# run nobody is watching. Generous enough to absorb a slow API fetch.
max_runtime=20
curl_max_time=6
curl_connect_timeout=5

main_pid=$$
orig_ppid=$PPID
self_path=$(readlink -f "${BASH_SOURCE[0]}")

case "$direction" in
  down | up)
    ;;
  *)
    echo "Usage: omarchy-network-speedtest [down|up]" >&2
    exit 2
    ;;
esac

format_mbps() {
  awk -v value="$1" 'BEGIN {
    if (value <= 0) print "0.0"
    else if (value < 10) printf "%.1f\n", value
    else printf "%.0f\n", value
  }'
}

# --- GUARD 1: single instance, replace on start ------------------------------
# Sweep by cmdline rather than by a recorded pid. Orphaned workers share our
# exact argv[1], and a stale pidfile pointing at a dead parent would otherwise
# let them survive a replace. SIGKILL, not SIGTERM: a worker blocked on a
# foreground curl defers SIGTERM until that curl returns, so kill its curl
# first, then it.
lock_dir="${XDG_RUNTIME_DIR:-/tmp}/omarchy-network-speedtest"
pidfile="$lock_dir/holder.pid"
mkdir -p "$lock_dir"

claim_lock() {
  local pid argv1
  for pid in /proc/[0-9]*; do
    pid=${pid#/proc/}
    (( pid == main_pid )) && continue
    argv1=$(tr '\0' '\n' <"/proc/$pid/cmdline" 2>/dev/null | sed -n 2p) || continue
    [[ $argv1 == "$self_path" ]] || continue
    pkill -KILL -P "$pid" 2>/dev/null || true
    kill -KILL "$pid" 2>/dev/null || true
  done
  echo "$main_pid" >"$pidfile"
}
claim_lock

iface=$(ip route get "$probe" 2>/dev/null | awk '{ for (i = 1; i <= NF; i++) if ($i == "dev") { print $(i + 1); exit } }')

if [[ -z $iface || ! -r /sys/class/net/$iface/statistics/rx_bytes || ! -r /sys/class/net/$iface/statistics/tx_bytes ]]; then
  echo "No active network interface" >&2
  exit 1
fi

if ! omarchy-cmd-present curl; then
  echo "curl is required" >&2
  exit 1
fi

fast_token="YXNkZmFzZGxmbnNkYWZoYXNkZmhrYWxm"
fast_api_url="https://api.fast.com/netflix/speedtest/v2?https=true&token=$fast_token&urlCount=$url_count"

# The stock version has no timeout here either, so a stalled API call hangs the
# run before it has even started.
# An array rather than a string: the worker takes one URL per argument, and
# splitting a string on whitespace to get there is a URL away from a bug.
mapfile -t fast_urls < <(curl -fsS --connect-timeout "$curl_connect_timeout" --max-time 15 "$fast_api_url" 2>/dev/null | jq -r '.targets[]?.url // empty')

if (( ! ${#fast_urls[@]} )); then
  echo "Failed to fetch speed test endpoints" >&2
  exit 1
fi

traffic_pids=()
watchdog_pid=""

any_alive() {
  local pid
  for pid in "${traffic_pids[@]}"; do
    [[ -n $pid ]] || continue
    kill -0 "$pid" 2>/dev/null && return 0
  done
  return 1
}

cleanup() {
  # Killing background jobs makes bash print "Terminated <cmd>" to stderr.
  # Nothing below reports anything worth keeping, so drop it.
  exec 2>/dev/null
  local pid i
  if [[ -n $watchdog_pid ]]; then kill "$watchdog_pid" 2>/dev/null || true; fi

  # Kill the curls first: a worker sitting in a foreground curl cannot act on
  # its own SIGTERM until that curl returns, so this is what unblocks it.
  for pid in "${traffic_pids[@]}"; do
    [[ -n $pid ]] || continue
    pkill -TERM -P "$pid" 2>/dev/null || true
    kill -TERM "$pid" 2>/dev/null || true
  done

  # Bounded grace, then escalate. Never block here: the shell SIGKILLs us if we
  # take too long, and anything still running when that happens is orphaned.
  for (( i = 0; i < 15; i++ )); do
    any_alive || break
    sleep 0.1
  done
  for pid in "${traffic_pids[@]}"; do
    [[ -n $pid ]] || continue
    pkill -KILL -P "$pid" 2>/dev/null || true
    kill -KILL "$pid" 2>/dev/null || true
  done

  if [[ -r $pidfile ]] && [[ $(<"$pidfile") == "$main_pid" ]]; then
    rm -f "$pidfile"
  fi
}
trap cleanup EXIT
# Exit 0: a SIGTERM here is a designed stop (the panel's phaseTimer, the
# watchdog, or a replacing instance), not a failure. The panel only inspects
# the exit code on an *unexpected* stop, and a non-zero code there would show a
# spurious error banner.
trap 'exec 2>/dev/null; exit 0' TERM INT

( sleep "$max_runtime"; kill -TERM "$main_pid" 2>/dev/null ) &
watchdog_pid=$!

# --- GUARD 2: the worker bounds itself --------------------------------------
# This is the guard that matters. A worker exits on its own deadline and checks
# that the parent is still alive each pass, so even a SIGKILLed parent leaves
# nothing behind for longer than one curl timeout.
traffic_worker() {
  local urls=("$@")
  local n=${#urls[@]}
  local idx=$RANDOM
  local deadline=$(( SECONDS + max_runtime ))
  local url
  while (( SECONDS < deadline )); do
    kill -0 "$main_pid" 2>/dev/null || return 0
    url=${urls[$((idx % n))]}
    if [[ $direction == "down" ]]; then
      curl -fsS -o /dev/null --connect-timeout "$curl_connect_timeout" --max-time "$curl_max_time" "$url" 2>/dev/null || return 0
    else
      dd if=/dev/zero bs=1M count=64 2>/dev/null \
        | curl -fsS -o /dev/null --connect-timeout "$curl_connect_timeout" --max-time "$curl_max_time" -X POST --data-binary @- "$url" 2>/dev/null || return 0
    fi
    idx=$((idx + 1))
  done
}

for (( i = 0; i < parallel; i++ )); do
  traffic_worker "${fast_urls[@]}" &
  traffic_pids+=("$!")
done

rx_before=$(cat "/sys/class/net/$iface/statistics/rx_bytes")
tx_before=$(cat "/sys/class/net/$iface/statistics/tx_bytes")

# --- GUARD 3: reparenting check ---------------------------------------------
# Compare against the pid we started under. Checking for ppid 1 is wrong on a
# systemd system: orphans are adopted by `systemd --user`, whose pid is not 1,
# so that test would never fire.
orphaned() {
  local ppid
  ppid=$(awk '{print $4}' "/proc/$main_pid/stat" 2>/dev/null) || return 1
  [[ -n $ppid ]] && (( ppid != orig_ppid ))
}

while any_alive; do
  orphaned && break
  sleep 1
  rx_after=$(cat "/sys/class/net/$iface/statistics/rx_bytes")
  tx_after=$(cat "/sys/class/net/$iface/statistics/tx_bytes")

  if [[ $direction == "down" ]]; then
    rate=$(awk -v before="$rx_before" -v after="$rx_after" 'BEGIN {
      if (after < before) print 0
      else print (after - before) * 8 / 1000000
    }')
  else
    rate=$(awk -v before="$tx_before" -v after="$tx_after" 'BEGIN {
      if (after < before) print 0
      else print (after - before) * 8 / 1000000
    }')
  fi

  format_mbps "$rate"
  rx_before=$rx_after
  tx_before=$tx_after
done

wait 2>/dev/null || true
