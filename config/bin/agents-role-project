#!/usr/bin/env python3
"""Project a schema-validated policy into staged, narrowly owned frontend artifacts.

Steward owns YAML/schema parsing and exact catalog authorization. This helper validates
the consumer envelope and supports only the two explicitly recognized frontend instances.
"""
import hashlib
import json
import os
from pathlib import Path
import re
import stat
import subprocess
import sys
import tempfile

MARK = "# Generated by agents-instructions-gen; policy SHA256: "
NAMES = {"read": "reader", "execute": "executor", "review": "reviewer",
         "critical-review": "critical-reviewer", "plan": "planner"}
FAMILIES = {"claudeAgent": "claude", "codex": "codex"}
ROLE_BLOCK = re.compile(r"Model roles are assigned by hand until a generated policy replaces them:.*?Read a quick lookup in a known file directly\.", re.S)


def refuse(message):
    raise ValueError(message)


def safe_path(path):
    """Reject symlinks in any component, including dangling links."""
    for item in (path, *path.parents):
        if item.is_symlink():
            refuse(f"symlink refused: {item}")


def raw_policy(path):
    safe_path(path)
    if not path.is_file() or path.stat().st_size > 1024 * 1024:
        refuse("policy must be an explicit regular file no larger than 1 MiB")
    return path.read_bytes(), path.stat()


def same_policy(path, raw, identity):
    current, info = raw_policy(path)
    if current != raw or (info.st_dev, info.st_ino, info.st_mtime_ns) != (
            identity.st_dev, identity.st_ino, identity.st_mtime_ns):
        refuse("policy changed during generation")


def strict_object(pairs):
    result = {}
    for key, value in pairs:
        if key in result:
            refuse(f"duplicate consumer key: {key}")
        result[key] = value
    return result


def fields(value, required, optional=()):
    if not isinstance(value, dict) or not set(required) <= value.keys() or (
            value.keys() - set(required) - set(optional)):
        refuse("malformed policy consumer response")


def consume(path):
    raw, identity = raw_policy(path)
    completed = subprocess.run(
        ["t3-steward", "policy", "show", "--file", str(path), "--json"],
        capture_output=True, text=True, timeout=30, check=True)
    same_policy(path, raw, identity)
    policy = json.loads(completed.stdout, object_pairs_hook=strict_object)
    fields(policy, ("schema", "roles", "digest"))
    digest = hashlib.sha256(raw).hexdigest()
    if policy["schema"] != "route-policy/v1" or policy["digest"] != digest:
        refuse("consumer schema or raw policy digest mismatch")
    if not isinstance(policy["roles"], list) or not policy["roles"]:
        refuse("consumer roles must be a nonempty ordered list")
    seen = set()
    for role in policy["roles"]:
        fields(role, ("name", "candidates"), ("constraints",))
        name = role["name"]
        if not isinstance(name, str) or name not in (*NAMES, "3d") or name in seen:
            refuse("unsupported or duplicate native role")
        seen.add(name)
        constraints = role.get("constraints", {})
        fields(constraints, (), ("providerFamilies", "excludeProviderFamilies", "tiers"))
        for key, values in constraints.items():
            allowed = ("economy", "standard", "premium") if key == "tiers" else ("claude", "codex")
            if (not isinstance(values, list) or any(not isinstance(v, str) or v not in allowed for v in values)
                    or len(set(values)) != len(values)):
                refuse(f"unsupported constraint: {key}")
        if set(constraints.get("providerFamilies", [])) & set(constraints.get("excludeProviderFamilies", [])):
            refuse("conflicting provider constraints")
        candidates = role["candidates"]
        if not isinstance(candidates, list) or not candidates:
            refuse("missing ordered candidates")
        routes = set()
        for candidate in candidates:
            fields(candidate, ("route", "effort", "tier"))
            route = candidate["route"]
            if not isinstance(route, str) or not re.fullmatch(r"[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+", route):
                refuse("invalid frontend route")
            instance, model = route.split("/")
            if instance not in FAMILIES or route in routes:
                refuse("unsupported frontend provider or duplicate route")
            routes.add(route)
            if candidate["effort"] not in ("low", "medium", "high"):
                refuse("unsupported frontend effort")
            if candidate["tier"] not in ("economy", "standard", "premium"):
                refuse("unsupported tier")
            if constraints.get("tiers") and candidate["tier"] not in constraints["tiers"]:
                refuse("candidate violates tier constraint")
            if instance == "claudeAgent":
                alias(model)  # unsupported family must never silently fall through
                if name == "3d":
                    refuse("3d is Codex-only")
    if not set(NAMES) <= seen:
        refuse("policy lacks one of the five required native roles")
    return policy, raw, identity


def alias(model):
    match = re.fullmatch(r"claude-(opus|sonnet|haiku|fable)-[0-9]+(?:-[0-9]+)*", model)
    if not match:
        refuse(f"unsupported Claude family alias: {model}")
    return match[1]


def select(role, instance):
    constraints = role.get("constraints", {})
    family = FAMILIES[instance]
    if (constraints.get("providerFamilies") and family not in constraints["providerFamilies"]
            or family in constraints.get("excludeProviderFamilies", [])):
        refuse(f"role {role['name']} excludes required native provider {family}")
    for candidate in role["candidates"]:
        if candidate["route"].split("/")[0] == instance:
            return candidate
    refuse(f"role {role['name']} has no candidate for {family}")


def guidance(policy, instance):
    lines = ["## Model roles (" + FAMILIES[instance] + ")", "",
             MARK + policy["digest"],
             "Policy candidates remain ordered; the first eligible same-provider candidate is projected.",
             "Tier is a constraint, never authorization. Exact catalog authorization stays with Steward.",
             "Family aliases are frontend projection only; they do not authorize exact catalog models.",
             "Never use max effort or above. Read a quick lookup in a known file directly.",
             "Use native roles only for bounded same-provider work; resume the parent afterward.",
             "Independent or cross-provider work remains a declared Steward task or review.",
             "Session/operator provider and effort restrictions require explicit route pins.",
             "Phase A roles do not promise nested reviews, quota failover or M16/M17 compilation.", ""]
    for role in policy["roles"]:
        if role["name"] == "3d" and instance != "codex":
            continue
        candidate = select(role, instance)
        lines += [f"- {role['name']}: {candidate['route']}, effort {candidate['effort']}; "
                  + "ordered policy " + json.dumps(role, separators=(",", ":"))]
    return "\n".join(lines)


def replace_roles(text, replacement):
    changed, count = ROLE_BLOCK.subn(lambda _: replacement, text)
    if count != 1:
        refuse("source role-template mismatch")
    return changed


def validate_fences(text):
    intervals = []
    for name in ("fleet", "jocasta"):
        first, last = f"<!-- {name}:start -->", f"<!-- {name}:end -->"
        if first in text or last in text:
            if text.count(first) != 1 or text.count(last) != 1 or text.index(last) < text.index(first):
                refuse("malformed instruction block")
            intervals.append((text.index(first), text.index(last) + len(last)))
    intervals.sort()
    if len(intervals) == 2 and intervals[0][1] > intervals[1][0]:
        refuse("overlapping instruction blocks")


def managed_instructions(home):
    # Exact generated references only; no ownership of sibling paths or the directory.
    return {str(home / ".config/agents" / name) for name in (
        "AGENTS.md", "ov-memory.md", "huyang.md", "t3-steward.md",
        "t3-campaign-executor-briefs.md", "jocasta.md", "agent99.md")}


def merged_codex(text, shared):
    start, end = "<!-- fleet:start -->", "<!-- fleet:end -->"
    legacy_start, legacy_end = "<!-- jocasta:start -->", "<!-- jocasta:end -->"
    validate_fences(text)
    if legacy_start in text:
        text = text[:text.index(legacy_start)].rstrip() + "\n" + text[text.index(legacy_end) + len(legacy_end):].lstrip()
    block = start + "\n" + shared.strip() + "\n" + end
    if start in text:
        text = text[:text.index(start)] + block + text[text.index(end) + len(end):]
    else:
        text = (text.rstrip() + "\n\n" + block + "\n").lstrip()
    validate_fences(text)
    return text


def run(root, stage, policy_path, check):
    safe_path(root)
    for source in (root / "config/claude/CLAUDE.md", root / "config/bin/agents-instructions-gen",
                   root / "config/bin/agents-role-project"):
        safe_path(source)
    for source in (root / "config/claude/skills").rglob("*"):
        safe_path(source)
    policy, raw, identity = consume(policy_path)
    digest = policy["digest"]
    shared = replace_roles((stage / "AGENTS.md").read_text(), guidance(policy, "codex"))
    outputs = {".config/agents/" + path.name: path.read_bytes() for path in stage.glob("*.md")}
    outputs[".config/agents/AGENTS.md"] = shared.encode()
    outputs[".claude/omarchy-setup/CLAUDE.md"] = replace_roles(
        (root / "config/claude/CLAUDE.md").read_text(), guidance(policy, "claudeAgent")).encode()
    native = set()
    for role in policy["roles"]:
        if role["name"] == "3d":
            continue
        name = NAMES[role["name"]]
        claude = select(role, "claudeAgent")
        codex = select(role, "codex")
        metadata = MARK + digest + "\n# Ordered policy: " + json.dumps(role, separators=(",", ":")) + "\n"
        agent_path = f".claude/agents/{name}.md"
        profile_path = f".codex/{name}.config.toml"
        outputs[agent_path] = ("---\nname: " + name + "\ndescription: Bounded same-provider " + role["name"]
            + " work\nmodel: " + alias(claude["route"].split("/")[1]) + "\neffort: "
            + claude["effort"] + "\n---\n" + metadata
            + "Do bounded same-provider work and return to the parent. Never replace a declared task "
            + "or independent review. Follow the parent session's provider and effort restrictions.\n").encode()
        outputs[profile_path] = (metadata + "model = " + json.dumps(codex["route"].split("/")[1])
            + "\nmodel_reasoning_effort = " + json.dumps(codex["effort"]) + "\n").encode()
        native.update((agent_path, profile_path))
    home = Path(os.environ["HOME"]).absolute()
    safe_path(home)
    codex_path = home / ".codex/AGENTS.md"
    safe_path(codex_path)
    outputs[".codex/AGENTS.md"] = merged_codex(
        codex_path.read_text() if codex_path.exists() else "", shared).encode()
    opencode_path = home / ".config/opencode/opencode.json"
    safe_path(opencode_path)
    if opencode_path.exists():
        config = json.loads(opencode_path.read_text(), object_pairs_hook=strict_object)
        if not isinstance(config, dict) or not isinstance(config.get("instructions", []), list):
            refuse("OpenCode instructions must be a list")
        managed = managed_instructions(home)
        config["instructions"] = [str(home / ".config/agents/AGENTS.md")] + [
            entry for entry in config.get("instructions", []) if str(entry) not in managed]
        outputs[".config/opencode/opencode.json"] = (json.dumps(config, indent=2) + "\n").encode()
    # Preflight every destination before the first write. Own exact native files only.
    for name in outputs:
        destination = home / name
        safe_path(destination)
        resolved = destination.resolve()
        policy_resolved = policy_path.resolve()
        if (resolved == policy_resolved or resolved in policy_resolved.parents
                or policy_resolved in resolved.parents
                or destination.exists() and destination.samefile(policy_path)):
            refuse(f"policy/output collision: {destination}")
        for parent in destination.parents:
            if parent.exists() and not parent.is_dir():
                refuse(f"non-directory output ancestor: {parent}")
        if destination.exists():
            if not destination.is_file():
                refuse(f"non-file output collision: {destination}")
            if name in native and not any(line.startswith(MARK) for line in destination.read_text().splitlines()):
                refuse(f"unmanaged native output collision: {destination}")
    same_policy(policy_path, raw, identity)
    if check:
        differences = [name for name, content in outputs.items()
                       if not (home / name).exists() or (home / name).read_bytes() != content]
        for name in differences:
            print(f"  ~/{name}: differs from policy-backed generation")
        return 3 if differences else 0
    # All generated bytes are staged before mutation; no native directory cleanup.
    prepared = stage / "policy-outputs"
    for name, content in outputs.items():
        path = prepared / name
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_bytes(content)
    same_policy(policy_path, raw, identity)
    for name in outputs:
        destination = home / name
        destination.parent.mkdir(parents=True, exist_ok=True)
        mode = stat.S_IMODE(destination.stat().st_mode) if destination.exists() else 0o644
        fd, temporary = tempfile.mkstemp(prefix=".agents-", dir=destination.parent)
        try:
            with os.fdopen(fd, "wb") as handle:
                handle.write((prepared / name).read_bytes())
                os.fchmod(handle.fileno(), mode)
            os.replace(temporary, destination)
        finally:
            if os.path.exists(temporary):
                os.unlink(temporary)
    print("wrote policy-backed artifacts; policy SHA256: " + digest)
    return 0


if __name__ == "__main__":
    try:
        sys.exit(run(Path(sys.argv[1]).absolute(), Path(sys.argv[2]),
                     Path(sys.argv[3]).absolute(), sys.argv[4] == "check"))
    except (ValueError, OSError, subprocess.SubprocessError, UnicodeError) as error:
        print("agents-role-project: " + str(error), file=sys.stderr)
        sys.exit(1)
