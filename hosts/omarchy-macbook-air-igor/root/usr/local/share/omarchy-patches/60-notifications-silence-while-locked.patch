+  // Omarchy only blanks the display while the session is locked, and
+  // Hyprland does not release a layer surface's replaced buffers until it
+  // presents a frame. A toast committed to the powered-off output therefore
+  // leaves a full-screen buffer behind until the display wakes, which is
+  // gigabytes after a night of notifications. Nothing can see a toast behind
+  // the lock anyway, so locked notifications go straight to history.
+  function sessionLocked() {
+    var lock = service.shell ? service.shell.serviceFor("omarchy.lock") : null
+    return !!(lock && lock.locked)
+  }
