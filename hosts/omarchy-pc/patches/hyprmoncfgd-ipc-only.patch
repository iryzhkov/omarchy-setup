+package main
+
+import "testing"
+
+func TestIPCOnlyFlag(t *testing.T) {
+	for _, args := range [][]string{nil, {"--ipc-only"}, {"--ipc-only=false"}} {
+		cmd := newRootCmd()
+		if err := cmd.ParseFlags(args); err != nil {
+			t.Fatal(err)
+		}
+		got, err := cmd.Flags().GetBool("ipc-only")
+		if err != nil {
+			t.Fatal(err)
+		}
+		want := len(args) == 1 && args[0] == "--ipc-only"
+		if got != want {
+			t.Fatalf("args=%v: ipc-only=%v, want %v", args, got, want)
+		}
+	}
+}
