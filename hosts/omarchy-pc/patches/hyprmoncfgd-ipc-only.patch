new file mode 100644
index 0000000..239848b
--- /dev/null
+++ b/internal/daemon/ipc_only_test.go
@@ -0,0 +1,276 @@
+package daemon
+
+import (
+	"context"
+	"encoding/json"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/crmne/hyprmoncfg/internal/hypr"
+	"github.com/crmne/hyprmoncfg/internal/ipc"
+	"github.com/crmne/hyprmoncfg/internal/lid"
+	"github.com/crmne/hyprmoncfg/internal/profile"
+)
+
+func ipcOnlyConfig(c *Config) {
+	c.IPCOnly = true
+	c.PollInterval = 20 * time.Millisecond
+	c.RecoveryInterval = 20 * time.Millisecond
+	c.RecoveryMaxInterval = 40 * time.Millisecond
+}
+
+func assertNoBackgroundWrites(t *testing.T, env runTestEnv, before []byte) {
+	t.Helper()
+	// Multiple poll, debounce, wake-settle and recovery intervals must elapse.
+	time.Sleep(250 * time.Millisecond)
+	data, err := os.ReadFile(env.logPath)
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, line := range strings.Split(strings.TrimSpace(string(data)), "\n") {
+		if !strings.HasPrefix(line, "-j ") {
+			t.Fatalf("unexpected compositor mutation: %s\n%s", line, data)
+		}
+	}
+	root, err := os.ReadFile(env.svc.cfg.HyprConfig)
+	if err != nil || string(root) != "# human config\n" {
+		t.Fatalf("background repaired the root include: %s (%v)", root, err)
+	}
+	got, err := os.ReadFile(env.monitorsConfPath)
+	if err != nil || string(got) != string(before) {
+		t.Fatalf("background changed generated config: %s (%v)", got, err)
+	}
+}
+
+func TestIPCOnlyEventLoopNeverReconciles(t *testing.T) {
+	for _, state := range []string{"mismatch", "unmatched", "sleeping", "modeless", "disabled", "disconnected"} {
+		t.Run(state, func(t *testing.T) {
+			connected := listenMonitorEvents(t)
+			original := []hypr.Monitor{
+				{Name: "DP-1", Make: "Example", Model: "Desk", Serial: "DESK", Width: 1920, Height: 1080, RefreshRate: 60, Scale: 1, Disabled: true},
+				{Name: "HDMI-A-1", Make: "Sony", Model: "TV", Serial: "TV", Width: 3840, Height: 2160, RefreshRate: 60, Scale: 1, DPMSStatus: true},
+			}
+			switch state {
+			case "sleeping":
+				original[1].DPMSStatus = false
+			case "modeless":
+				original[1].Width, original[1].Height = 0, 0
+			case "disabled":
+				original[1].Disabled = true
+			}
+			env := newRunTestEnvConfigured(t, original, ipcOnlyConfig, func(s *Service) {
+				// Startup must not repair this missing include: writing the root
+				// config could trigger a compositor reload outside hyprctl.
+				if err := os.WriteFile(s.cfg.HyprConfig, []byte("# human config\n"), 0644); err != nil {
+					t.Fatal(err)
+				}
+				if state == "disconnected" {
+					if err := writeMonitorState(filepath.Join(filepath.Dir(s.cfg.MonitorsConf), "monitors.json"), nil); err != nil {
+						t.Fatal(err)
+					}
+				}
+				if state == "unmatched" {
+					if err := s.store.Delete("Home"); err != nil {
+						t.Fatal(err)
+					}
+					return
+				}
+				desk := append([]hypr.Monitor{}, original...)
+				if len(desk) > 0 {
+					desk[0].Disabled, desk[0].DPMSStatus = false, true
+					desk[1].Disabled = true
+				}
+				if err := s.store.Save(profile.FromMonitors("desk", desk)); err != nil {
+					t.Fatal(err)
+				}
+				s.setManualOverride(profile.MonitorSetHash(original), profile.FromMonitors("Home", original))
+			})
+			defer env.stop()
+			send := connected()
+			waitFor(t, time.Second, func() bool { return env.logs.contains("IPC-only mode:") }, "IPC-only startup")
+			status, err := env.svc.Status()
+			if err != nil || !status.Daemon.IPCOnly {
+				t.Fatalf("IPC-only capability absent: %+v (%v)", status.Daemon, err)
+			}
+			encoded, err := json.Marshal(status)
+			if err != nil || !strings.Contains(string(encoded), `"ipc_only":true`) {
+				t.Fatalf("IPC-only wire capability absent: %s (%v)", encoded, err)
+			}
+			before, err := os.ReadFile(env.monitorsConfPath)
+			if err != nil {
+				t.Fatal(err)
+			}
+			if _, err := env.svc.EditorState(); err != nil {
+				t.Fatalf("editor unavailable at startup in %s state: %v", state, err)
+			}
+			assertNoBackgroundWrites(t, env, before)
+			// Exercise the actual socket2 event loop with changed hardware. A
+			// manual pin cannot provide this guarantee: it expires for this set.
+			changed := append(append([]hypr.Monitor{}, original...), hypr.Monitor{Name: "DP-9", Make: "Other", Model: "New", Serial: "NEW", Disabled: true})
+			if err := writeMonitorState(env.monitorStatePath, changed); err != nil {
+				t.Fatal(err)
+			}
+			send("monitoradded>>DP-9")
+			waitFor(t, time.Second, func() bool { return env.logs.contains("monitor event received: monitoradded") }, "topology event")
+			assertNoBackgroundWrites(t, env, before)
+
+			env.setLid(lid.Closed)
+			env.lidStates <- lid.Closed
+			env.setLid(lid.Open)
+			env.lidStates <- lid.Open
+			env.suspendEvents <- true
+			env.suspendEvents <- false
+			waitFor(t, time.Second, func() bool { return env.logs.contains("resumed from sleep") }, "resume event")
+			assertNoBackgroundWrites(t, env, before)
+			if _, err := env.svc.EditorState(); err != nil {
+				t.Fatalf("editor unavailable in %s state: %v", state, err)
+			}
+			// Shared entry points used by IPC management, rotation and recovery
+			// also stay fenced, even when explicitly asked to reconcile.
+			if err := env.svc.applyAutomatic(context.Background()); err != nil {
+				t.Fatal(err)
+			}
+			assertNoBackgroundWrites(t, env, before)
+		})
+	}
+}
+
+func TestIPCOnlyTransactionsWithRunningEventLoop(t *testing.T) {
+	connected := listenMonitorEvents(t)
+	monitors := []hypr.Monitor{
+		{Name: "DP-1", Make: "Example", Model: "Desk", Serial: "DESK", Width: 1920, Height: 1080, RefreshRate: 60, Scale: 1, DPMSStatus: true},
+		{Name: "HDMI-A-1", Make: "Sony", Model: "TV", Serial: "TV", Width: 3840, Height: 2160, RefreshRate: 60, X: 1920, Scale: 1, DPMSStatus: true},
+	}
+	env := newRunTestEnvConfigured(t, monitors, ipcOnlyConfig, func(s *Service) {
+		if err := os.WriteFile(s.cfg.HyprConfig, []byte("# human config\n"), 0644); err != nil {
+			t.Fatal(err)
+		}
+		// The compositor snapshot includes an existing workspace on the TV.
+		helper := filepath.Join(filepath.Dir(s.cfg.MonitorsConf), "hyprctl")
+		data, err := os.ReadFile(helper)
+		if err != nil {
+			t.Fatal(err)
+		}
+		script := strings.Replace(string(data),
+			"if [[ \"${1-}\" == \"-j\" && \"${2-}\" == \"workspaces\" ]]; then\n  printf '[]'",
+			"if [[ \"${1-}\" == \"-j\" && \"${2-}\" == \"workspaces\" ]]; then\n  printf '[{\"id\":2,\"name\":\"2\",\"monitor\":\"HDMI-A-1\"}]'", 1)
+		if string(data) == script {
+			t.Fatal("workspace fixture replacement missed")
+		}
+		if err := os.WriteFile(helper, []byte(script), 0755); err != nil {
+			t.Fatal(err)
+		}
+	})
+	defer env.stop()
+	send := connected()
+	socketPath := filepath.Join(os.Getenv("XDG_RUNTIME_DIR"), "ipc.sock")
+	ctx, cancel := context.WithCancel(context.Background())
+	server := &ipc.Server{Path: socketPath, Handler: env.svc}
+	done := make(chan error, 1)
+	go func() { done <- server.Run(ctx) }()
+	defer func() {
+		cancel()
+		if err := <-done; err != nil {
+			t.Error(err)
+		}
+		if err := env.svc.Shutdown(); err != nil {
+			t.Error(err)
+		}
+	}()
+	waitFor(t, time.Second, func() bool { _, err := os.Stat(socketPath); return err == nil }, "IPC socket")
+	callCtx, stopCalls := context.WithTimeout(context.Background(), 15*time.Second)
+	defer stopCalls()
+	client, err := ipc.Dial(callCtx, socketPath)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer client.Close()
+	if _, err := client.EditorState(callCtx); err != nil {
+		t.Fatal(err)
+	}
+	before, err := os.ReadFile(env.monitorsConfPath)
+	if err != nil {
+		t.Fatal(err)
+	}
+	assertNoBackgroundWrites(t, env, before)
+	target := profile.FromMonitors("Explicit", monitors)
+	target.Workspaces = profile.WorkspaceSettings{Enabled: true, Strategy: profile.WorkspaceStrategyManual,
+		Rules: []profile.WorkspaceRule{{Workspace: "2", OutputKey: monitors[0].HardwareKey()}}}
+	tx, err := client.Preview(callCtx, ipc.PreviewParams{Profile: &target, TimeoutSeconds: 10})
+	if err != nil {
+		t.Fatal(err)
+	}
+	root, err := os.ReadFile(env.svc.cfg.HyprConfig)
+	if err != nil || !strings.Contains(string(root), "source = "+env.monitorsConfPath) {
+		t.Fatalf("explicit preview did not own its include: %s (%v)", root, err)
+	}
+	if !hyprctlLogContains(env.logPath, "dispatch moveworkspacetomonitor 2 DP-1") {
+		t.Fatal("explicit preview did not move the planned workspace")
+	}
+	// Topology events must not overwrite an active interactive preview.
+	send("monitoradded>>DP-9")
+	time.Sleep(200 * time.Millisecond)
+	if err := client.Revert(callCtx, tx.ID); err != nil {
+		t.Fatal(err)
+	}
+	if !hyprctlLogContains(env.logPath, "dispatch moveworkspacetomonitor 2 HDMI-A-1") {
+		t.Fatal("revert did not restore the original workspace placement")
+	}
+	if got, err := os.ReadFile(env.monitorsConfPath); err != nil || string(got) != string(before) {
+		t.Fatalf("revert did not restore generated config: %s (%v)", got, err)
+	}
+	root, err = os.ReadFile(env.svc.cfg.HyprConfig)
+	if err != nil || string(root) != "# human config\n" {
+		t.Fatalf("revert did not restore the root include: %s (%v)", root, err)
+	}
+	// Safety expiry remains enabled. It belongs to an explicit transaction.
+	tx, err = client.Preview(callCtx, ipc.PreviewParams{Profile: &target, TimeoutSeconds: 1})
+	if err != nil {
+		t.Fatal(err)
+	}
+	waitFor(t, 3*time.Second, func() bool { return env.logs.contains("profile preview expired and was reverted") }, "preview safety rollback")
+	if got, err := os.ReadFile(env.monitorsConfPath); err != nil || string(got) != string(before) {
+		t.Fatalf("expiry did not restore generated config: %s (%v)", got, err)
+	}
+	tx, err = client.Preview(callCtx, ipc.PreviewParams{Profile: &target, TimeoutSeconds: 10})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := client.Commit(callCtx, tx.ID, true); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := env.svc.store.Load("Explicit"); err != nil {
+		t.Fatalf("commit did not save the profile: %v", err)
+	}
+	// After commit, another hardware change and several polls must leave
+	// both the explicit generated file and the mutation log untouched.
+	written, err := os.ReadFile(env.monitorsConfPath)
+	if err != nil {
+		t.Fatal(err)
+	}
+	logBefore, err := os.ReadFile(env.logPath)
+	if err != nil {
+		t.Fatal(err)
+	}
+	changed := append(append([]hypr.Monitor{}, monitors...), hypr.Monitor{Name: "DP-9", Make: "Other", Model: "New", Serial: "NEW", Disabled: true})
+	if err := writeMonitorState(env.monitorStatePath, changed); err != nil {
+		t.Fatal(err)
+	}
+	send("monitoradded>>DP-9")
+	time.Sleep(250 * time.Millisecond)
+	logAfter, err := os.ReadFile(env.logPath)
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, line := range strings.Split(strings.TrimSpace(string(logAfter[len(logBefore):])), "\n") {
+		if !strings.HasPrefix(line, "-j ") {
+			t.Fatalf("autonomous mutation after explicit commit: %s", line)
+		}
+	}
+	if got, err := os.ReadFile(env.monitorsConfPath); err != nil || string(got) != string(written) {
+		t.Fatalf("background overwrote committed layout: %s (%v)", got, err)
+	}
+}
