TV = "media_player.sony_living_room_tv"
SCREEN = "binary_sensor.living_room_tv_screen_on"
AVR = "media_player.str_az5000es_2"
BRAVIA = "media_player.bravia_4k_vh22"
CAST = "media_player.sony_xr_77a80cl"
ENTITIES = (TV, SCREEN, AVR, BRAVIA, CAST)
TV_OUTPUT = "HDMI-A-1"
POLL = 5
REDISCOVER_COOLDOWN = 300
REDISCOVER_TIMEOUT = 60
REDISCOVER_HELPER = Path("/usr/local/libexec/display-hdmi-rediscover")
WATCHER_SHA256S = {
    "5b7415c8b25dcccc695c808163b9ff4602cdbacecabf23398a166bfe85623b48",
    # Installed root-owned script, qualified from the root read-only receipt.
    "124c14fbc0285cf195e529d7cdee6f90baeec2c9a1421f9b9a3cec933024eced",
}
ERRORS = (OSError, ValueError, KeyError, TypeError, subprocess.SubprocessError)


def choose(states):
    """Existing source precedence, with incomplete evidence represented by None."""
    by_id = {s["entity_id"]: s for s in states if isinstance(s, dict) and "entity_id" in s}
    screen, avr = by_id.get(SCREEN, {}), by_id.get(AVR, {})
    if screen.get("state") == "off" or avr.get("state") == "off":
        return "desk"
    if screen.get("state") != "on":
        return None
    if avr.get("state") in (None, "", "unknown", "unavailable"):
        return None
    tv = by_id.get(TV, {})
    source = tv.get("attributes", {}).get("source", "") if tv.get("state") in ("on", "idle", "playing", "paused") else ""
    fallback = by_id.get(BRAVIA, {})
    if not source and fallback.get("state") not in (None, "", "unknown", "unavailable"):
        source = fallback.get("attributes", {}).get("source", "")
    if not source:
        cast = by_id.get(CAST, {})
        attrs = cast.get("attributes", {})
        if cast.get("state") in ("playing", "paused") and attrs.get("app_name") == "TV":
            source = attrs.get("media_title", "")
    source = str(source).strip().lower()
    if not source:
        return None
    return "tv-game" if source in ("hdmi 3", "hdmi 3 (earc/arc)", "str-az5000es") else "desk"


def sony_edid_identity(data):
    """Accept only a complete, checksummed Sony EDID with a display name."""
    if (not isinstance(data, bytes) or len(data) < 128 or len(data) > 4096
            or data[:8] != b"\x00\xff\xff\xff\xff\xff\xff\x00"
            or data[8:10] != b"\x4d\xd9"
            or len(data) != 128 * (1 + data[126])
            or any(sum(data[i:i + 128]) % 256 for i in range(0, len(data), 128))):
        return None
    for offset in range(54, 126, 18):
        descriptor = data[offset:offset + 18]
        if descriptor[:5] == b"\x00\x00\x00\xfc\x00":
            try:
                model = descriptor[5:18].decode("ascii").strip()
            except UnicodeDecodeError:
                return None
            if model:
                return {"make": "Sony", "model": model,
                        "serial": "0x" + format(int.from_bytes(data[12:16], "little"), "08X")}
    return None


def receiver_handshake(monitors, profiles, states, identity):
    """Recognize only our receiver's stale identity backed by the real TV EDID."""
    by_id = {s["entity_id"]: s for s in states if isinstance(s, dict) and "entity_id" in s}
    avr = by_id.get(AVR, {})
    if (choose(states) != "tv-game"
            or avr.get("state") != "on"
            or avr.get("attributes", {}).get("source") != "Racing"
            or identity is None or "tv-game" not in profiles):
        return False
    wanted = targets(profiles["tv-game"])
    hdmi = [m for m in monitors if m.get("name") == TV_OUTPUT]
    if (len(wanted) != 1 or wanted[0]["name"] != TV_OUTPUT or len(hdmi) != 1
            or hdmi[0].get("make") != "Sony" or hdmi[0].get("model") != "SONY AVSYSTEM"
            or any(not wanted[0].get(k) or identity.get(k) != wanted[0][k]
                   for k in ("make", "model", "serial"))
            or hdmi[0].get("serial") != "0x01010101"
            or wanted[0]["serial"] != "0x01010101"
            or hdmi[0].get("disabled") is not False):
        return False
    identified = copy.deepcopy(monitors)
    next(m for m in identified if m["name"] == TV_OUTPUT).update(identity)
    return topology(identified, profiles, profiles["tv-game"])


def drm_size(report):
    """Resolve this connector's encoder and CRTC, never an unrelated head."""
    connector = re.search(r"^\d+\s+(\d+)\s+connected\s+HDMI-A-1\s", report, re.M)
    if not connector:
        return None
    encoder = re.search(r"^" + connector[1] + r"\s+(\d+)\s+TMDS\s", report, re.M)
    if not encoder or encoder[1] == "0":
        return None
    crtc = re.search(r"^" + encoder[1] + r"\s+\d+\s+\([^\n]*?\)\s+\((\d+)x(\d+)\)", report, re.M)
    return (int(crtc[1]), int(crtc[2])) if crtc else None


def check(monitors, actual):
    enabled = [m for m in monitors if m.get("disabled") is False]
    tv = next((m for m in enabled if m.get("name") == TV_OUTPUT), None)
    if len(enabled) != 1 or not tv or tv.get("dpmsStatus") is not True or actual is None:
        return {"health": "unavailable"}
    expected = (tv.get("width"), tv.get("height"))
    if not all(isinstance(v, int) and v > 0 for v in expected):
        return {"health": "unavailable"}
    return {"health": "healthy" if expected == actual else "mismatch",
            "expected": expected, "actual": actual}


def run(args, timeout=5):
    """Kill the entire helper process group on timeout, including ha's jq."""
    proc = subprocess.Popen(args, text=True, stdout=subprocess.PIPE,
                            stderr=subprocess.PIPE, start_new_session=True)
    try:
        out, err = proc.communicate(timeout=timeout)
    except BaseException:
        with contextlib.suppress(ProcessLookupError):
            os.killpg(proc.pid, signal.SIGKILL)
        proc.communicate(timeout=2)
        raise
    if proc.returncode:
        raise subprocess.CalledProcessError(proc.returncode, args, out, err)
    return out


DESK_SINK = "alsa_output.usb-Focusrite_Scarlett_2i2_4th_Gen_S2GWT264BA655C-00.HiFi__Line1__sink"


def sony_product(properties):
    if not isinstance(properties, dict):
        raise ValueError("invalid audio product properties")
    return any(re.search(r"\bSONY\b", str(properties.get(key, "")), re.I)
               for key in ("device.product.name", "alsa.name"))


def named_items(value):
    """pactl versions expose ports/profiles as either maps or named arrays."""
    if isinstance(value, dict):
        items = list(value.items())
    elif isinstance(value, list) and all(isinstance(item, dict) for item in value):
        items = [(item["name"], item) for item in value]
    else:
        raise ValueError("invalid audio ports/profiles")
    if any(not isinstance(name, str) or not isinstance(item, dict) for name, item in items):
        raise ValueError("invalid audio port/profile entry")
    return items


class Audio:
    """Only route playback; preserve channel mode, capture, volume and mute."""
    def __init__(self, system, clock=time.monotonic):
        self.system, self.clock = system, clock
        self.profile_attempts = {}

    def listing(self, kind):
        value = json.loads(self.system.pactl("-f", "json", "list", kind))
        if not isinstance(value, list) or any(not isinstance(item, dict) for item in value):
            raise ValueError("invalid audio " + kind)
        return value

    def sony_sink(self, sinks, guard):
        ports = []
        for card in self.listing("cards"):
            if not str(card.get("name", "")).startswith("alsa_card.pci-"):
                continue
            for name, port in named_items(card.get("ports", {})):
                if (name.startswith("hdmi-output-") and port.get("availability") == "available"
                        and sony_product(port.get("properties", {}))):
                    ports.append((card, name, port))
        if len(ports) != 1:
            raise ValueError("Sony HDMI port unavailable or ambiguous")
        card, name, port = ports[0]

        def matching(items):
            matches = []
            for sink in items:
                active = sink.get("active_port")
                if isinstance(active, dict):
                    active = active.get("name")
                props = sink.get("properties", {})
                if not isinstance(props, dict):
                    raise ValueError("invalid sink properties")
                same_card = (props["device.name"] == card["name"] if "device.name" in props else
                             "card" in sink and str(sink["card"]) == str(card.get("index")))
                if same_card and active == name and sony_product(props):
                    matches.append(sink)
            if len(matches) > 1:
                raise ValueError("Sony sink ambiguous")
            return matches[0] if matches else None

        sink = matching(sinks)
        if sink:
            return sink  # Do not change an existing stereo/surround profile.
        profiles = dict(named_items(card.get("profiles", {})))
        available = [p for p in port.get("profiles", [])
                     if p.startswith("output:hdmi-") and p in profiles
                     and profiles[p].get("available") in (True, "yes", "available")]
        active = card.get("active_profile")
        if isinstance(active, dict):
            active = active.get("name")
        if not available:
            raise ValueError("Sony HDMI has no available output profile")
        chosen = active if active in available else min(
            available, key=lambda p: (not p.startswith("output:hdmi-stereo"), p))
        if chosen != active:
            key = (card["name"], name, chosen)
            if self.clock() - self.profile_attempts.get(key, float("-inf")) < 60:
                raise ValueError("Sony profile retry deferred")
            guard()
            self.profile_attempts[key] = self.clock()
            self.system.pactl("set-card-profile", card["name"], chosen)
        # PipeWire can publish the sink after set-card-profile returns.
        for attempt in range(4):
            if attempt:
                self.system.wait(0.25)
            sink = matching(self.listing("sinks"))
            if sink:
                return sink
        raise ValueError("Sony sink publication timed out")

    def reconcile(self, route, guard):
        sinks = self.listing("sinks")
        if route == "tv-game":
            target = self.sony_sink(sinks, guard)
        else:
            matches = [sink for sink in sinks if sink.get("name") == DESK_SINK]
            if len(matches) != 1:
                raise ValueError("Focusrite playback sink unavailable or ambiguous")
            target = matches[0]
        name, index = target["name"], target["index"]
        default = self.system.pactl("get-default-sink").strip()
        streams = [s for s in self.listing("sink-inputs") if str(s["sink"]) != str(index)]
        if default != name or streams:
            guard()  # Recheck sleep/preview/layout after discovery and publication waits.
        if default != name:
            self.system.pactl("set-default-sink", name)
        for stream in streams:
            self.system.pactl("move-sink-input", str(stream["index"]), name)


def verified_audio_route(system, editor, profiles, monitors):
    """Use the current saved layout and physical scanout, never pending HA intent."""
    name = editor.get("source_profile")
    if name not in profiles or not topology(monitors, profiles, profiles[name]):
        return None
    wanted = targets(profiles[name])[0]
    enabled = [m for m in monitors if m.get("disabled") is False]
    if (enabled[0]["name"] != wanted["name"]
            or (enabled[0].get("width"), enabled[0].get("height")) != (wanted["width"], wanted["height"])):
        return None
    if name.startswith("tv-") and check(monitors, system.drm())["health"] != "healthy":
        return None
    return "desk" if name == "desk" else "tv-game"


class IPC:
    """One connection owns the complete preview/commit/revert lifecycle."""
    def __init__(self, path, timeout=25, clock=time.monotonic, connect=socket.socket):
        self.path, self.timeout, self.clock, self.connect = path, timeout, clock, connect
        self.sock = None
        self.buffer = b""
        self.sequence = 0

    def __enter__(self):
        self.sock = self.connect(socket.AF_UNIX, socket.SOCK_STREAM)
        try:
            self.sock.settimeout(self.timeout)
            self.sock.connect(str(self.path))
        except BaseException:
            self.sock.close()
            raise
        return self

    def __exit__(self, *_):
        if self.sock is not None:
            self.sock.close()

    def request(self, method, **params):
        if self.sock is None:
            raise ValueError("IPC is not connected")
        self.sequence += 1
        request_id = str(self.sequence)
        deadline = self.clock() + self.timeout
        message = {"protocol_version": 1, "type": "request", "id": request_id,
                   "method": method, "params": params}
        self.sock.settimeout(self.timeout)
        self.sock.sendall(json.dumps(message).encode() + b"\n")
        while True:
            remaining = deadline - self.clock()
            if remaining <= 0:
                raise TimeoutError("IPC response timeout")
            self.sock.settimeout(remaining)
            if b"\n" not in self.buffer:
                chunk = self.sock.recv(65536)
                if not chunk:
                    raise ConnectionError("IPC disconnected")
                self.buffer += chunk
                if len(self.buffer) > 4 * 1024 * 1024:
                    raise ValueError("IPC message too large")
                continue
            line, self.buffer = self.buffer.split(b"\n", 1)
            reply = json.loads(line)
            if reply.get("protocol_version") != 1:
                raise ValueError("unsupported IPC protocol")
            if reply.get("type") == "event":
                continue
            if reply.get("type") != "response" or reply.get("id") != request_id:
                raise ValueError("unexpected IPC response")
            if reply.get("error"):
                raise ValueError("IPC: " + str(reply["error"]))
            return reply.get("result")


class System:
    def __init__(self, runtime, stop):
        self.runtime, self.stop = runtime, stop
        self.watcher_holds = None

    def ha(self):
        states = []
        for entity in ENTITIES:
            if self.stop.is_set():
                raise InterruptedError("stopping")
            states.append(json.loads(run([str(Path.home() / ".local/bin/ha"), "--json",
                                          "api", "/api/states/" + entity], timeout=12)))
            if choose(states) is not None:
                break  # unused fallback helpers must not gate a valid source
        return states

    def ipc(self, timeout=25):
        return IPC(self.runtime / "hyprmoncfgd.sock", timeout=timeout)

    def pactl(self, *args):
        return run(["pactl", *args], timeout=5)

    def audio_lock(self):
        return coordinator_lock(self.runtime, "display-controller-audio.lock")

    def monitors(self):
        result = json.loads(run(["hyprctl", "monitors", "all", "-j"]))
        if not isinstance(result, list) or any(not isinstance(m, dict) for m in result):
            raise ValueError("invalid compositor monitor list")
        return result

    def wake(self):
        run(["hyprctl", "dispatch", 'hl.dsp.dpms({ action = "on" })'])

    def tv_edid(self):
        paths = list(Path("/sys/class/drm").glob("card*-HDMI-A-1/edid"))
        if len(paths) != 1:
            return None
        with paths[0].open("rb") as source:
            return sony_edid_identity(source.read(4097))

    def verify_watcher_claim(self):
        scopes = json.loads(run(["systemctl", "--user", "list-units", "--all",
                                 "--type=scope", "--output=json", "--no-pager"]))
        if not isinstance(scopes, list) or any(not isinstance(s, dict) for s in scopes):
            raise ValueError("cannot verify watcher ownership")
        if any(s.get("description") == "omarchy-hyprland-monitor-watch"
               and s.get("active") in ("active", "activating") for s in scopes):
            raise ValueError("new child has not reclaimed Omarchy watcher")

    def recovery_pending(self):
        return (self.runtime / "display-hdmi-recovery.json").exists() if self.runtime else False

    def workspace_snapshot(self):
        value = json.loads(run(["hyprctl", "workspaces", "-j"]))
        workspace_placement(value)
        return value

    def command(self, *args):
        result = run(["hyprctl", *args])
        if result.strip() != "ok":
            raise ValueError("Hyprland recovery command rejected")

    def workspaces(self):
        return workspace_placement(json.loads(run(["hyprctl", "workspaces", "-j"])))

    def move_special_workspaces(self, output, guard):
        migrate_workspaces(output, guard, special_only=True)

    def drm(self):
        return drm_size(run(["modetest", "-M", "nvidia-drm", "-e", "-c", "-p"]))

    def wait(self, seconds):
        if self.stop.wait(seconds):
            raise InterruptedError("stopping")


def targets(profile):
    return [o for o in profile["outputs"] if o.get("enabled") is True]


class WorkspacePlacement(dict):
    """Placement plus workspaces that cannot legitimately disappear while moving."""

    def __init__(self):
        super().__init__()
        self.required = set()


def workspace_placement(workspaces):
    """Read regular workspace selectors and their current output."""
    if not isinstance(workspaces, list):
        raise ValueError("invalid compositor workspace list")
    placement = WorkspacePlacement()
    for workspace in workspaces:
        if not isinstance(workspace, dict):
            raise ValueError("invalid compositor workspace")
        name, number = workspace.get("name"), workspace.get("id")
        monitor = workspace.get("monitor")
        if (not isinstance(name, str) or not name or type(number) is not int
                or not isinstance(monitor, str) or not monitor
                or any(ord(c) < 32 or c == ";" for c in name)):
            raise ValueError("invalid compositor workspace identity")
        # The daemon also excludes special workspaces from its rollback moves.
        if name.startswith("special:"):
            continue
        selector = str(number) if number > 0 else "name:" + name
        if selector in placement:
            raise ValueError("duplicate compositor workspace")
        placement[selector] = monitor
        # Hyprland may remove an empty, nonpersistent workspace after its monitor
        # is disabled. Missing metadata is not evidence that a workspace is empty.
        if (type(workspace.get("windows")) is not int or workspace["windows"] != 0
                or workspace.get("ispersistent") is not False):
            placement.required.add(selector)
    if not placement:
        raise ValueError("no regular workspaces available")
    return placement


def migrate_workspaces(output, guard, special_only=False):
    """Move regulars then specials; return a verifier for after source teardown."""
    before = json.loads(run(["hyprctl", "workspaces", "-j"]))
    specials = {w["name"]: w["monitor"] for w in before
                if w["name"].startswith("special:")}
    if special_only and all(monitor == output for monitor in specials.values()):
        # No write means no visibility/placement contract to enforce across a
        # concurrent user toggle or destruction of an already placed special.
        return lambda final=False: None
    placement = workspace_placement(before)
    if any(not name[8:] for name in specials):
        raise ValueError("invalid special workspace")
    def visible():
        return {m.get("specialWorkspace", {}).get("name")
                for m in json.loads(run(["hyprctl", "monitors", "all", "-j"]))
                if m.get("specialWorkspace", {}).get("name")}
    shown = visible()
    if len(shown) > 1:
        raise ValueError("multiple visible specials cannot share one output")
    moves = ([] if special_only else list(placement.items())) + list(specials.items())
    for selector, monitor in moves:
        if monitor == output:
            continue
        guard()
        # v0.56.2 WorkspacePlacementController preserves visible/hidden specials.
        result = run(["hyprctl", "eval", "hl.dispatch(hl.dsp.workspace.move({workspace="
                      + json.dumps(selector, ensure_ascii=False) + ",monitor=" + json.dumps(output) + "}))"])
        if result.strip() != "ok":
            raise ValueError("workspace move rejected")
    def verify(final=False):
        after = json.loads(run(["hyprctl", "workspaces", "-j"]))
        regular = workspace_placement(after)
        remaining = {w["name"]: w["monitor"] for w in after if w["name"].startswith("special:")}
        # Moving the last active regular creates an empty source replacement.
        # v0.56.2 can reuse the ID of a destroyed empty target workspace. Only
        # explicitly empty nonpersistent workspaces may wait for teardown; those
        # required before migration must still survive and reach the target.
        misplaced = {s for s, m in regular.items() if m != output}
        allowed = set() if final else regular.keys() - regular.required - placement.required
        if (not placement.required <= regular.keys()
                or (not special_only and not misplaced <= allowed)
                or any(remaining.get(name) != output for name in specials)
                or visible() != shown):
            raise ValueError("workspace migration or special visibility verification failed")
    verify()
    return verify


def workspace_profile(profile, placement):
    """Give this single-output preview explicit, unsaved workspace moves."""
    effective = copy.deepcopy(profile)
    output = targets(effective)[0]
    settings = effective.setdefault("workspaces", {})
    rules = {}
    for rule in settings.get("rules", []):
        selector = rule["workspace"]
        if not selector.startswith("special:"):
            rules[selector] = dict(rule)
    for selector in placement:
        rules.setdefault(selector, {"workspace": selector})
    for rule in rules.values():
        rule.update(output_key=output.get("key", ""), output_name=output["name"])
    settings.update(enabled=True, strategy="manual", rules=list(rules.values()))
    return effective


def require_ipc_only(daemon):
    if daemon.get("ipc_only") is not True:
        raise ValueError("hyprmoncfgd does not report ipc_only=true")
    if daemon.get("running") is not True:
        raise ValueError("hyprmoncfgd is not running")


def normalize_editor(editor, daemon):
    """Resolve null source metadata only under a running, managed IPC-only daemon."""
    require_ipc_only(daemon)
    if daemon.get("preview") or daemon.get("unmanaged"):
        raise ValueError("display is owned by a preview or unmanaged layout")
    # An explicit source, including an unknown name, always takes precedence.
    # The override identifies a possible live profile, never HA intent or authority.
    if editor.get("source_profile") is None:
        name = daemon.get("profile_override")
        if name in ("desk", "tv-game", "tv-recovery"):
            return {**editor, "source_profile": name}
    return editor


def topology(monitors, profiles, target, require_awake=True):
    """Permit only known connectors and one current output; normally awake."""
    names = [m.get("name") for m in monitors]
    known = {o["name"] for p in profiles.values() for o in p["outputs"]}
    enabled = [m for m in monitors if m.get("disabled") is False]
    wanted = targets(target)
    if (not names or len(names) != len(set(names)) or not set(names) <= known
            or len(enabled) != 1 or (require_awake and enabled[0].get("dpmsStatus") is not True)
            or len(wanted) != 1 or wanted[0]["name"] not in names):
        return False
    # Connector names alone cannot authorize an unfamiliar replacement display.
    for m in monitors:
        candidates = [o for p in profiles.values() for o in p["outputs"] if o["name"] == m["name"]]
        identified = [o for o in candidates if any(o.get(k) for k in ("make", "model", "serial"))]
        if not any(all(not o.get(k) or o[k] == m.get(k) for k in ("make", "model", "serial"))
                   for o in (identified or candidates)):
            return False
    return True


class Coordinator:
    def __init__(self, system, clock=time.monotonic):
        self.system, self.clock = system, clock
        self.selected = None
        self.ha_route = None
        self.observed_profile = None
        self.daemon_ready = False
        self.candidate = None
        self.since = 0
        self.count = 0
        self.key = None
        self.route_attempted = False
        self.recovery_attempted = False
        self.receiver_attempted = False
        self.receiver_last_attempt = float("-inf")
        self.receiver_count = 0
        self.receiver_since = 0
        self.rediscover_healthy = 0
        self.rediscovery_request = None
        self.sleep_observed = False
        self.sleep_count = 0
        self.wake_rearmed = False
        self.wake_intent = False
        self.wake_deadline = 0
        self.last_known_route = None
        self.mismatch = None
        self.mismatch_since = 0
        self.mismatch_count = 0
        self.health = "starting"
        self.last_action = None
        self.error = None
        self.audio = Audio(system, clock)
        self.audio_health, self.audio_error = "deferred", None

    def status(self, pid=None):
        return {"selected_route": self.selected, "ha_route": self.ha_route,
                "observed_profile": self.observed_profile, "daemon_ready": self.daemon_ready,
                "health": self.health, "audio_health": self.audio_health,
                "audio_error": self.audio_error,
                "policy_deferred": self.daemon_ready and self.health in (
                    "ready; policy deferred", "preview", "unmanaged", "route debounce",
                    "topology unavailable or asleep", "HA uncertain; live route verified",
                    "HA uncertain; live layout unverified", "unavailable", "mismatch",
                    "route attempt inhibited", "recovery inhibited",
                    "receiver handshake pending", "receiver handshake inhibited"),
                "daemon_pid": pid, "last_action": self.last_action,
                "error": self.error, "recovery_inhibited": self.recovery_attempted,
                "receiver_recovery_attempted": self.receiver_attempted,
                "hdmi_recovery_pending": self.system.recovery_pending()}

    def reset_mismatch(self):
        self.mismatch, self.mismatch_count = None, 0

    def reconnect_receiver(self, ipc, profiles, monitors, states):
        fault = (any(m.get("name") == TV_OUTPUT and m.get("model") == "SONY AVSYSTEM"
                     for m in monitors)
                 and receiver_handshake(monitors, profiles, states, self.system.tv_edid()))
        if not fault:
            self.receiver_count = 0
            # Rearm only after two fully verified healthy TV observations.
            # Failed queries and jitter never count as a fault ending.
            healthy = (choose(states) == "tv-game" and "tv-game" in profiles
                       and topology(monitors, profiles, profiles["tv-game"])
                       and verified_audio_route(self.system, {"source_profile": "tv-game"},
                                                profiles, monitors) == "tv-game")
            self.rediscover_healthy = self.rediscover_healthy + 1 if healthy else 0
            if self.rediscover_healthy >= 2:
                self.receiver_attempted = False
            return False
        self.rediscover_healthy = 0
        now = self.clock()
        if not self.receiver_count:
            self.receiver_since = now
        self.receiver_count += 1
        self.health = "HDMI identity pending"
        if self.receiver_count < 2 or now - self.receiver_since < POLL:
            return True
        if self.receiver_attempted or now - self.receiver_last_attempt < REDISCOVER_COOLDOWN:
            self.health = "HDMI identity inhibited"
            return True
        fresh = self.system.ha()
        if (not receiver_handshake(self.system.monitors(), profiles, fresh, self.system.tv_edid())
                or self.clock() - now > POLL):
            self.receiver_count = 0
            return True
        daemon = ipc.request("status")["daemon"]
        require_ipc_only(daemon)
        if daemon.get("preview") or daemon.get("unmanaged"):
            self.receiver_count = 0
            return True
        # Process outside this connection's context, after the old IPC is closed.
        self.receiver_attempted, self.receiver_last_attempt = True, self.clock()
        self.rediscovery_request = copy.deepcopy(profiles)
        return True

    def transaction(self, ipc, name, profiles, verify=False):
        # Race with a human preview is also rejected atomically by the daemon.
        daemon = ipc.request("status")["daemon"]
        require_ipc_only(daemon)
        if daemon.get("preview"):
            raise ValueError("human preview active")
        before = self.system.monitors()
        if verify and not any(m.get("name") == TV_OUTPUT and m.get("disabled") is False for m in before):
            raise ValueError("TV no longer active")
        if choose(self.system.ha()) != self.candidate or not topology(before, profiles, profiles[name]):
            raise ValueError("route or topology changed")
        placement = self.system.workspaces()
        effective = workspace_profile(profiles[name], placement)
        tx = ipc.request("preview", profile=effective, timeout_seconds=120, save_on_commit=False)
        transaction_id = tx["id"]
        try:
            if verify:
                self.system.wait(2)
                monitors = self.system.monitors()
                state = check(monitors, self.system.drm())
                wanted = targets(profiles[name])[0]
                if (choose(self.system.ha()) != "tv-game"
                        or not topology(monitors, profiles, profiles[name])
                        or state["health"] != "healthy"
                        or state["expected"] != (wanted["width"], wanted["height"])):
                    raise ValueError("physical verification failed for " + name)
            else:
                # No wake or second modeset when the user sleeps during apply.
                monitors = self.system.monitors()
                enabled_names = [m["name"] for m in monitors if m.get("disabled") is False]
                if (choose(self.system.ha()) != self.candidate or not topology(monitors, profiles, profiles[name])
                        or enabled_names != [targets(profiles[name])[0]["name"]]):
                    raise ValueError("route or topology changed during preview")
            after = self.system.workspaces()
            output = targets(effective)[0]["name"]
            if not placement.required <= after.keys() or any(m != output for m in after.values()):
                raise ValueError("workspace placement verification failed for " + name)
            ipc.request("commit", transaction_id=transaction_id, save=False)
        except ERRORS:
            # Revert only our own transaction on this connection. An IPC timeout
            # may leave the deadline armed; never reclaim someone else's preview.
            ipc.request("revert", transaction_id=transaction_id)
            restored = self.system.workspaces()
            if (not placement.required <= restored.keys()
                    or any(restored[w] != m for w, m in placement.items() if w in restored)):
                raise ValueError("workspace rollback verification failed for " + name)
            raise
        self.last_action = "committed " + name

    def adopt(self, editor, profiles, monitors, verify_scanout=True):
        """Observe a saved live match, without converting it into HA intent."""
        self.observed_profile = None
        name = editor.get("source_profile")
        if name not in profiles or not topology(monitors, profiles, profiles[name]):
            return False
        wanted = targets(profiles[name])[0]
        enabled = [m for m in monitors if m.get("disabled") is False]
        if (enabled[0]["name"] != wanted["name"]
                or (enabled[0].get("width"), enabled[0].get("height")) != (wanted["width"], wanted["height"])):
            return False
        if verify_scanout and name.startswith("tv-") and check(monitors, self.system.drm())["health"] != "healthy":
            return False
        self.selected = "desk" if name == "desk" else "tv-game"
        self.observed_profile = name
        return True

    def reconcile_audio(self, editor, profiles, monitors, requested=None):
        if self.system.recovery_pending():
            self.audio_health, self.audio_error = "deferred", None
            return
        try:
            with self.system.audio_lock():
                route = verified_audio_route(self.system, editor, profiles, monitors)
                if route is None or (requested is not None and requested != route):
                    self.audio_health = "deferred"
                    return
                def guard():
                    with self.system.ipc() as ipc:
                        daemon = ipc.request("status")["daemon"]
                        require_ipc_only(daemon)
                        if daemon.get("preview") or daemon.get("unmanaged"):
                            raise ValueError("audio deferred during preview or unmanaged layout")
                        current = normalize_editor(ipc.request("editor_state"), daemon)
                        current_profiles = {p["name"]: p for p in current["profiles"]
                                            if p["name"] in ("desk", "tv-game", "tv-recovery")}
                        if verified_audio_route(self.system, current, current_profiles,
                                                self.system.monitors()) != route:
                            raise ValueError("audio live route changed")
                self.audio.reconcile(route, guard)
                self.audio_health, self.audio_error = "healthy", None
        except Exception as exc:
            # Optional audio failures, including malformed nested pactl data,
            # must never escape into display debounce/recovery or stop the daemon.
            self.audio_health, self.audio_error = "unavailable", str(exc)

    def step(self, states=None):
        self.audio_health, self.audio_error = "deferred", None
        self.observed_profile = None
        self.daemon_ready = False
        try:
            try:
                observed_states = self.system.ha() if states is None else states
                desired = choose(observed_states)
            except ERRORS as exc:
                desired, self.error = None, "HA: " + str(exc)
                observed_states = []
                self.rediscover_healthy = 0
            now = self.clock()
            if (desired == "tv-game" and desired != self.candidate
                    and self.last_known_route == "desk"):
                self.wake_intent = True
                self.wake_deadline = now + 3 * POLL
                # Consume the confirmed desk edge even if a later query fails.
                self.last_known_route = "tv-game"
            elif desired != "tv-game":
                self.wake_intent = False
            if now > self.wake_deadline:
                self.wake_intent = False
            self.ha_route = desired
            if desired != "tv-game":
                self.receiver_count = 0
                self.rediscover_healthy = 0
            if desired is None:
                self.candidate, self.count = None, 0
                self.reset_mismatch()
            elif desired != self.candidate:
                self.candidate, self.since, self.count = desired, now, 1
            else:
                self.count += 1
            with self.system.ipc() as ipc:
                status = ipc.request("status")
                daemon = status["daemon"]
                require_ipc_only(daemon)
                self.daemon_ready = True
                if daemon.get("preview") or daemon.get("unmanaged"):
                    self.receiver_count = 0
                    self.rediscover_healthy = 0
                    self.wake_intent = False
                    self.sleep_count = 0
                    self.sleep_observed = False
                    self.reset_mismatch()
                    self.health = "preview" if daemon.get("preview") else "unmanaged"
                    return
                editor = normalize_editor(ipc.request("editor_state"), daemon)
                profiles = {p["name"]: p for p in editor["profiles"]
                            if p["name"] in ("desk", "tv-game", "tv-recovery")}
                monitors = self.system.monitors()
                if self.system.recovery_pending():
                    self.health = "HDMI recovery journal pending"
                    return
                self.reconcile_audio(editor, profiles, monitors)
                if desired is None:
                    verified = self.adopt(editor, profiles, monitors)
                    self.health = "HA uncertain; live route verified" if verified else "HA uncertain; live layout unverified"
                    return
                # A compositor match is enough to retain the current route;
                # physical mismatch is handled by bounded recovery below.
                self.adopt(editor, profiles, monitors, verify_scanout=False)
                supported = (desired in profiles
                             and topology(monitors, profiles, profiles[desired], require_awake=False)
                             and (desired != "tv-game" or targets(profiles[desired])[0]["name"] == TV_OUTPUT))
                if not supported:
                    self.wake_intent = False
                    self.sleep_count = 0
                    self.sleep_observed = False
                if self.count < 2 or now - self.since < POLL:
                    self.health = "route debounce"
                    return
                self.last_known_route = desired
                # A confirmed sleep/wake cycle starts a new bounded attempt.
                # Query failures, mode changes and continuous awake polls do not.
                if supported:
                    enabled = next(m for m in monitors if m.get("disabled") is False)
                    if enabled.get("dpmsStatus") is False:
                        self.sleep_count += 1
                        self.sleep_observed = self.sleep_count >= 2
                        if self.clock() > self.wake_deadline:
                            self.wake_intent = False
                        if self.wake_intent:
                            # Only a fresh desk -> TV selection may wake displays.
                            # Existing TV intent at startup or intentional idle
                            # sleep never causes a periodic wake.
                            self.wake_intent = False
                            self.system.wake()
                            self.health = "display wake requested"
                            return
                    elif enabled.get("dpmsStatus") is True:
                        if self.sleep_observed and not self.wake_rearmed:
                            self.route_attempted = self.recovery_attempted = False
                            self.wake_rearmed = True
                        self.sleep_count = 0
                        self.sleep_observed = False
                        self.wake_intent = False
                else:
                    self.wake_intent = False
                    self.sleep_count = 0
                    self.sleep_observed = False
                key = (desired, json.dumps(profiles, sort_keys=True),
                       tuple(sorted((m["name"], m.get("serial", "")) for m in monitors)))
                if key != self.key:
                    self.key = key
                    self.route_attempted = self.recovery_attempted = False
                    self.wake_rearmed = False
                    self.reset_mismatch()
                if (desired == "tv-game" and editor.get("source_profile") in (None, *profiles)
                        and self.reconnect_receiver(ipc, profiles, monitors, observed_states)):
                    return
                if (desired not in profiles or not topology(monitors, profiles, profiles[desired])
                        or (desired == "tv-game" and targets(profiles[desired])[0]["name"] != TV_OUTPUT)):
                    self.reset_mismatch()
                    self.health = "topology unavailable or asleep"
                    return
                if self.selected != desired or self.observed_profile not in (
                        ("tv-game", "tv-recovery") if desired == "tv-game" else ("desk",)):
                    if self.route_attempted:
                        self.health = "route attempt inhibited"
                        return
                    self.route_attempted = True
                    self.transaction(ipc, desired, profiles)
                    self.selected, self.error = desired, None
                    self.reset_mismatch()
                    self.health = "route applied"
                    return
                # Reconcile specials only after the final HA route is healthy.
                # The daemon's transactions move regular workspaces only.
                if verified_audio_route(self.system, editor, profiles, monitors) == desired:
                    def guard_specials():
                        current = ipc.request("status")["daemon"]
                        require_ipc_only(current)
                        if (current.get("preview") or current.get("unmanaged")
                                or choose(self.system.ha()) != desired):
                            raise ValueError("special workspace route changed")
                        current_editor = normalize_editor(ipc.request("editor_state"), current)
                        current_profiles = {p["name"]: p for p in current_editor["profiles"]
                                            if p["name"] in ("desk", "tv-game", "tv-recovery")}
                        if verified_audio_route(self.system, current_editor, current_profiles,
                                                self.system.monitors()) != desired:
                            raise ValueError("special workspace route changed")
                    self.system.move_special_workspaces(
                        targets(profiles[self.observed_profile])[0]["name"], guard_specials)
                if desired != "tv-game":
                    self.health = "desk"
                    self.reset_mismatch()
                    return
                state = check(monitors, self.system.drm())
                self.health = state["health"]
                if self.health != "mismatch":
                    self.reset_mismatch()
                    return
                signature = (state["expected"], state["actual"])
                if signature != self.mismatch:
                    self.mismatch, self.mismatch_since, self.mismatch_count = signature, now, 1
                else:
                    self.mismatch_count += 1
                if self.mismatch_count < 2 or now - self.mismatch_since < POLL:
                    return
                if self.recovery_attempted:
                    self.health = "recovery inhibited"
                    return
                self.recovery_attempted = True
                if "tv-recovery" not in profiles or targets(profiles["tv-recovery"])[0]["name"] != TV_OUTPUT:
                    raise ValueError("TV recovery profile unavailable")
                self.transaction(ipc, "tv-recovery", profiles, verify=True)
                # The recovery snapshot is now committed. A rejected preferred
                # preview rolls back to it rather than trying a mode ladder.
                self.transaction(ipc, "tv-game", profiles, verify=True)
                self.health, self.error = "recovered", None
                self.reset_mismatch()
        except ERRORS as exc:
            self.receiver_count = 0
            self.rediscover_healthy = 0
            self.wake_intent = False
            self.sleep_count = 0
            self.sleep_observed = False
            self.candidate, self.count = None, 0
            self.reset_mismatch()
            self.health, self.error = "unavailable", str(exc)


def runtime_dir():
    path = Path(os.environ.get("XDG_RUNTIME_DIR", "/run/user/" + str(os.getuid())))
    info = path.stat()
    if not path.is_absolute() or not stat.S_ISDIR(info.st_mode) or info.st_uid != os.getuid() or info.st_mode & 0o077:
        raise ValueError("XDG_RUNTIME_DIR must be a private directory owned by this user")
    return path


@contextlib.contextmanager
def coordinator_lock(runtime, name="display-controller.lock"):
    fd = os.open(runtime / name, os.O_CREAT | os.O_RDWR | os.O_CLOEXEC | os.O_NOFOLLOW, 0o600)
    try:
        info = os.fstat(fd)
        if (not stat.S_ISREG(info.st_mode) or info.st_uid != os.getuid()
                or info.st_nlink != 1 or info.st_mode & 0o022):
            raise ValueError("unsafe coordinator lock")
        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        yield
    finally:
        os.close(fd)


def atomic_write(path, text):
    temporary = path.with_name(path.name + "." + str(os.getpid()))
    fd = os.open(temporary, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
    try:
        with os.fdopen(fd, "w") as stream:
            stream.write(text)
        os.replace(temporary, path)
    finally:
        with contextlib.suppress(FileNotFoundError):
            temporary.unlink()


def private_lock(runtime, name):
    """Watcher locks can predate us with mode 0644; only writes need exclusion."""
    return coordinator_lock(runtime, name)


def helper_preflight():
    for path in (REDISCOVER_HELPER, *REDISCOVER_HELPER.parents):
        info = path.lstat()
        if info.st_uid != 0 or info.st_mode & 0o022 or stat.S_ISLNK(info.st_mode):
            raise ValueError("HDMI helper and parents must be root-owned and protected")
    if not os.access(REDISCOVER_HELPER, os.X_OK):
        raise ValueError("HDMI helper is not executable")
    identity = json.loads(run(["sudo", "-n", str(REDISCOVER_HELPER), "--check"]))
    if identity != {"make": "Sony", "model": "SONY TV  *30", "serial": "0x01010101"}:
        raise ValueError("root helper did not confirm qualified TV")
    return identity


class ConnectorRefused(ValueError):
    """The root helper proved it refused before attempting off."""


class ConnectorProcess:
    """A bounded pipe handshake; EOF asks the privileged helper to compensate."""
    def __init__(self):
        self.proc = None
        self.buffer = b""
        self.detected = False
        self.refused = False
        self.closed = False

    def __enter__(self):
        self.proc = subprocess.Popen(
            ["sudo", "-n", str(REDISCOVER_HELPER), "--rediscover"],
            stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
        try:
            self.expect("ready")
        except BaseException:
            self.__exit__(None, None, None)
            raise
        return self

    def receive(self):
        deadline = time.monotonic() + 10
        while b"\n" not in self.buffer:
            remaining = deadline - time.monotonic()
            if remaining <= 0 or not select.select([self.proc.stdout], [], [], remaining)[0]:
                raise TimeoutError("root HDMI helper response timeout")
            chunk = os.read(self.proc.stdout.fileno(), 256)
            if not chunk or len(self.buffer) + len(chunk) > 1024:
                raise ValueError("root HDMI helper disconnected")
            self.buffer += chunk
        line, self.buffer = self.buffer.split(b"\n", 1)
        if line == b"refused-before-off":
            self.refused = True
            raise ConnectorRefused("root helper refused before connector off")
        if line == b"detect-restored":
            self.detected = True
        return line.decode("ascii")

    def expect(self, wanted):
        if self.receive() != wanted:
            raise ValueError("unexpected root HDMI helper response")

    def send(self, value):
        self.proc.stdin.write(value.encode("ascii") + b"\n")
        self.proc.stdin.flush()

    def off(self):
        try:
            self.send("off")
        except OSError:
            # A buffered refusal can precede a failed write/flush. Only that
            # explicit message proves no off; EOF alone remains uncertain.
            self.expect("disconnected")
            return
        self.expect("disconnected")

    def detect(self):
        self.send("detect")
        self.expect("detect-restored")
        if self.proc.wait(timeout=3) != 0:
            raise ValueError("root HDMI helper failed after detect")

    def __exit__(self, *_):
        if self.proc and not self.closed:
            self.closed = True
            try:
                # BufferedWriter.close can flush again after a broken pipe.
                # Still drain compensation/refusal and reap the exact helper.
                with contextlib.suppress(*ERRORS):
                    self.proc.stdin.close()
                try:
                    if not self.detected and not self.refused:
                        for _ in range(2):  # at most disconnected, then detect
                            message = self.receive()
                            if message == "detect-restored":
                                break
                            if message != "disconnected":
                                raise ValueError("unexpected HDMI cleanup response")
                except ERRORS:
                    pass
                self.proc.wait(timeout=10)
            finally:
                with contextlib.suppress(*ERRORS):
                    self.proc.stdout.close()


class Rediscovery:
    """One journal owns one backup and a bounded cleanup, never another off."""
    def __init__(self, system, child, coordinator):
        self.system, self.child, self.coordinator = system, child, coordinator
        self.path = system.runtime / "display-hdmi-recovery.json"
        self.transaction_id = None
        self.deadline = coordinator.clock() + REDISCOVER_TIMEOUT
        self.stopping_child = None
        self.handoff_incomplete = getattr(system, "watcher_holds", None) is not None

    @contextlib.contextmanager
    def watcher_exclusion(self):
        holds = getattr(self.system, "watcher_holds", None)
        if holds is None:
            holds = contextlib.ExitStack()
            try:
                holds.enter_context(private_lock(self.system.runtime, "omarchy-monitor-clamshell.lock"))
                holds.enter_context(private_lock(self.system.runtime, "omarchy-monitor-modeless.lock"))
            except BaseException:
                holds.close()
                raise
        try:
            yield
        finally:
            if self.handoff_incomplete:
                # The living supervisor retains exclusion until its exact child
                # is recreated and watcher reclamation is confirmed.
                self.system.watcher_holds = holds
            else:
                holds.close()
                self.system.watcher_holds = None

    def restart_owned(self):
        if (self.stopping_child is not None and self.child.proc is self.stopping_child
                and self.stopping_child.poll() is None):
            raise ValueError("owned child stop remains incomplete")
        if self.child.proc is not None and self.child.proc.poll() is not None:
            self.child.proc = None  # A reaped handle owned by this Child only.
        self.child.start()
        startup(self.system, self.coordinator)
        with self.system.ipc() as ipc:
            self.peer(ipc)
            require_ipc_only(ipc.request("status")["daemon"])
        self.system.verify_watcher_claim()
        self.handoff_incomplete = False

    def save(self, state):
        atomic_write(self.path, json.dumps(state) + "\n")

    def peer(self, ipc):
        import struct
        if self.child.proc is None or self.child.proc.poll() is not None:
            raise ValueError("owned daemon is not running")
        pid, uid, _ = struct.unpack("3i", ipc.sock.getsockopt(
            socket.SOL_SOCKET, socket.SO_PEERCRED, 12))
        if pid != self.child.proc.pid or uid != os.getuid():
            raise ValueError("IPC belongs to another daemon")

    def owner(self, ipc):
        self.peer(ipc)
        daemon = ipc.request("status")["daemon"]
        require_ipc_only(daemon)
        preview = daemon.get("preview")
        if (daemon.get("unmanaged")
                or (preview and preview.get("transaction_id") != self.transaction_id)):
            raise ValueError("human preview or unmanaged layout owns display")
        return daemon

    def guard(self, state, ipc=None, fault=False):
        if self.coordinator.clock() > self.deadline:
            raise TimeoutError("bounded HDMI recovery deadline exceeded; journal retained")
        if self.system.stop.is_set():
            raise InterruptedError("HDMI recovery cancelled; journal retained")
        if (self.system.runtime / "sunshine-virtual-display/state.json").exists():
            raise ValueError("Sunshine journal owns display")
        monitors = self.system.monitors()
        if fault:
            if not receiver_handshake(monitors, state["profiles"], self.system.ha(),
                                      self.system.tv_edid()):
                raise ValueError("HDMI fault or TV intent changed")
        else:
            known = [m for m in monitors if m.get("name") != state["output"]]
            if (choose(self.system.ha()) != "tv-game"
                    or any(m.get("name") not in ("DP-1", TV_OUTPUT, state["output"])
                           for m in monitors)
                    or len({m.get("name") for m in monitors}) != len(monitors)
                    or any(m.get("name") == "DP-1" and m.get("disabled") is not True
                           for m in monitors)):
                raise ValueError("HDMI recovery intent or topology changed")
            for monitor in known:
                candidates = [o for p in state["profiles"].values() for o in p["outputs"]
                              if o["name"] == monitor.get("name")]
                if monitor.get("name") == TV_OUTPUT and monitor.get("model") == "SONY AVSYSTEM":
                    if (monitor.get("make"), monitor.get("serial")) != ("Sony", "0x01010101"):
                        raise ValueError("unknown receiver identity")
                elif not any(all(not o.get(k) or o[k] == monitor.get(k)
                                 for k in ("make", "model", "serial")) for o in candidates):
                    raise ValueError("physical identity changed during recovery")
                if monitor.get("name") == TV_OUTPUT and (
                        monitor.get("disabled") is False and monitor.get("dpmsStatus") is not True):
                    raise ValueError("TV asleep during recovery")
        if ipc:
            self.owner(ipc)
        return monitors

    def converge(self, state, predicate, ipc=None):
        deadline = self.coordinator.clock() + 5
        while True:
            monitors = self.guard(state, ipc)
            if predicate(monitors):
                return monitors
            if self.coordinator.clock() >= deadline:
                raise TimeoutError("HDMI recovery convergence timeout")
            self.system.wait(0.1)

    def verify_workspaces(self, state, final=True):
        current = self.system.workspace_snapshot()
        placement = workspace_placement(current)
        before = workspace_placement(state["workspaces"])
        specials = {w["name"] for w in state["workspaces"] if w["name"].startswith("special:")}
        shown = sorted(m.get("specialWorkspace", {}).get("name")
                       for m in self.system.monitors() if m.get("specialWorkspace", {}).get("name"))
        misplaced = {s for s, m in placement.items() if m != TV_OUTPUT}
        allowed = set() if final else placement.keys() - placement.required - before.required
        if (not before.required <= placement.keys()
                or not misplaced <= allowed
                or any(not any(w["name"] == name and w["monitor"] == TV_OUTPUT for w in current)
                       for name in specials)
                or shown != state["shown"]):
            raise ValueError("original workspaces or special visibility not restored")

    def physical(self, state, monitors):
        physical = [m for m in monitors if m.get("name") != state["output"]]
        profile = state["profiles"]["tv-game"]
        if not topology(physical, state["profiles"], profile):
            return False
        tv = next(m for m in physical if m["name"] == TV_OUTPUT)
        wanted = targets(profile)[0]
        return (all(tv.get(k) == wanted.get(k) for k in ("width", "height", "scale", "transform", "x", "y"))
                and ("refresh" not in wanted or abs(tv.get("refreshRate", 0) - wanted["refresh"]) < 0.1)
                and check(physical, self.system.drm())["health"] == "healthy")

    def restore(self, state):
        # Fresh child only. Never reuse the old connection or assume startup
        # selected a profile. IPC-only startup cannot change the display.
        self.child.start()
        startup(self.system, self.coordinator)
        with self.system.ipc() as ipc:
            self.guard(state, ipc)
            editor = normalize_editor(ipc.request("editor_state"), ipc.request("status")["daemon"])
            current = {p["name"]: p for p in editor["profiles"] if p["name"] in state["profiles"]}
            if current != state["profiles"]:
                raise ValueError("saved profiles changed; recovery deferred")
            # Apply once after identity has returned, with no saved-profile edits.
            self.converge(state, lambda ms: any(
                m.get("name") == TV_OUTPUT and all(m.get(k) == targets(current["tv-game"])[0].get(k)
                  for k in ("make", "model", "serial")) for m in ms), ipc)
            effective = workspace_profile(current["tv-game"], self.system.workspaces())
            tx = ipc.request("preview", profile=effective, timeout_seconds=120, save_on_commit=False)
            self.transaction_id = tx["id"]
            # A failed/uncertain preview retains its rollback deadline and journal.
            try:
                monitors = self.converge(state, lambda ms: self.physical(state, ms), ipc)
                if any(m["name"] == state["output"] and m.get("disabled") is True for m in monitors):
                    self.guard(state, ipc)
                    self.system.command("eval", "hl.monitor({output=" + json.dumps(state["output"])
                                        + ",disabled=false})")
                    self.converge(state, lambda ms: any(m["name"] == state["output"]
                        and m.get("disabled") is False for m in ms), ipc)
                migration = migrate_workspaces(TV_OUTPUT, lambda: self.guard(state, ipc))
                self.verify_workspaces(state, final=False)
                self.guard(state, ipc)
                if any(m["name"] == state["output"] for m in self.system.monitors()):
                    self.system.command("output", "remove", state["output"])
                self.converge(state, lambda ms: all(m["name"] != state["output"] for m in ms)
                              and self.physical(state, ms), ipc)
                migration(final=True)
                self.verify_workspaces(state)
                self.guard(state, ipc)
                ipc.request("commit", transaction_id=self.transaction_id, save=False)
                self.transaction_id = None
            except BaseException:
                # Revert only this connection's own preview. Keep the backup
                # journal even if rollback succeeds; physical restoration is unproven.
                with contextlib.suppress(*ERRORS):
                    ipc.request("revert", transaction_id=self.transaction_id)
                raise
        self.path.unlink()



    def restore_before_off(self, state):
        """Undo only our workspace/backup changes, without applying a TV mode."""
        cleanup_deadline = self.coordinator.clock() + 10
        def guard():
            if self.coordinator.clock() > cleanup_deadline:
                raise TimeoutError("backup compensation deadline exceeded")
            if (self.system.runtime / "sunshine-virtual-display/state.json").exists():
                raise ValueError("Sunshine owns display during compensation")
            monitors = self.system.monitors()
            physical = [m for m in monitors if m["name"] != state["output"]]
            identified = copy.deepcopy(physical)
            # Either known Sony identity can now be present. Cleanup moves
            # workspaces only; it neither changes a mode nor wakes the output.
            for monitor in identified:
                if (monitor.get("name") == TV_OUTPUT
                        and (monitor.get("make"), monitor.get("model"), monitor.get("serial"))
                        == ("Sony", "SONY AVSYSTEM", "0x01010101")):
                    monitor.update(make="Sony", model="SONY TV  *30", serial="0x01010101")
            if (len(monitors) != len({m.get("name") for m in monitors})
                    or any(m.get("name") not in ("DP-1", TV_OUTPUT, state["output"]) for m in monitors)
                    or any(m.get("name") == "DP-1" and m.get("disabled") is not True for m in physical)
                    or not topology(identified, state["profiles"], state["profiles"]["tv-game"])
                    or not any(m.get("name") == TV_OUTPUT and m.get("disabled") is False
                               and m.get("dpmsStatus") is True for m in physical)):
                raise ValueError("known awake HDMI required for backup compensation")
            if self.child.proc is not None and self.child.proc.poll() is None:
                with self.system.ipc() as ipc:
                    self.owner(ipc)
            return monitors
        guard()
        migration = migrate_workspaces(TV_OUTPUT, guard)
        self.verify_workspaces(state, final=False)
        guard()
        if any(m["name"] == state["output"] for m in self.system.monitors()):
            self.system.command("output", "remove", state["output"])
        if any(m["name"] == state["output"] for m in guard()):
            raise ValueError("backup removal incomplete before off")
        migration(final=True)
        self.verify_workspaces(state)
        state["stage"] = "compensated"
        self.save(state)  # Ownership includes child/watcher restoration, not only backup removal.

    def resume(self):
        """One cleanup on process startup. Never issue another off."""
        info = self.path.lstat()
        if not stat.S_ISREG(info.st_mode) or info.st_uid != os.getuid() or info.st_mode & 0o077:
            raise ValueError("unsafe HDMI recovery journal")
        state = json.loads(self.path.read_text())
        if (state.get("version") != 1 or not re.fullmatch(r"HEADLESS-REDISCOVER-[0-9a-f]{32}",
                                                        state.get("output", ""))
                or state.get("stage") not in ("prepared", "backup", "detect-pending", "restore", "compensated")
                or not isinstance(state.get("profiles"), dict)
                or not isinstance(state.get("shown"), list)):
            raise ValueError("invalid HDMI recovery journal")
        workspace_placement(state["workspaces"])
        directory = self.system.runtime / "sunshine-virtual-display"
        with coordinator_lock(directory, "lock"), self.watcher_exclusion():
            with self.system.ipc() as ipc:
                if state["stage"] == "prepared":
                    # No display mutation to undo. Clearing ownership metadata
                    # must not gate on new HA intent or overwrite a human preview.
                    self.peer(ipc)
                    require_ipc_only(ipc.request("status")["daemon"])
                elif state["stage"] in ("backup", "compensated"):
                    self.owner(ipc)  # Compensation is independent of new HA route intent.
                else:
                    self.guard(state, ipc)
            self.system.verify_watcher_claim()
            self.handoff_incomplete = False
            if state["stage"] == "prepared":
                if any(m["name"] == state["output"] for m in self.system.monitors()):
                    raise ValueError("unexpected backup before prepared handoff")
                self.path.unlink()
                return
            if state["stage"] in ("backup", "compensated"):
                if state["stage"] == "backup":
                    self.restore_before_off(state)
                self.verify_workspaces(state)
                self.path.unlink()  # Owned child and watcher are already verified above.
                return
            if state["stage"] == "detect-pending":
                # Fixed helper detects only; no EDID required for compensation.
                run(["sudo", "-n", str(REDISCOVER_HELPER), "--detect"], timeout=5)
                state["stage"] = "restore"
                self.save(state)
            self.restore(state)

    def run(self, profiles):
        # The Sunshine lock covers its start preflight through service handoff.
        directory = self.system.runtime / "sunshine-virtual-display"
        directory.mkdir(mode=0o700, exist_ok=True)
        info = directory.lstat()
        if not stat.S_ISDIR(info.st_mode) or info.st_uid != os.getuid() or info.st_mode & 0o077:
            raise ValueError("unsafe Sunshine lock directory")
        with coordinator_lock(directory, "lock"):
            if self.path.exists():
                raise ValueError("HDMI recovery journal pending; explicit cleanup required")
            helper_preflight()  # No display takeover before helper/sudo qualification.
            wanted = targets(profiles["tv-game"])[0]
            if any(wanted.get(k) != v for k, v in (
                    ("make", "Sony"), ("model", "SONY TV  *30"), ("serial", "0x01010101"))):
                raise ValueError("saved TV differs from root helper identity")
            watcher = Path("/usr/share/omarchy/bin/omarchy-hyprland-monitor-watch")
            if hashlib.sha256(watcher.read_bytes()).hexdigest() not in WATCHER_SHA256S:
                raise ValueError("Omarchy watcher lock contract unqualified")
            with self.watcher_exclusion(), ConnectorProcess() as helper:
                state = {"version": 1, "owner": "display-controller",
                         "child_pid": self.child.proc.pid,
                         "output": "HEADLESS-REDISCOVER-" + uuid.uuid4().hex,
                         "profiles": profiles, "physical": self.system.monitors(),
                         "workspaces": self.system.workspace_snapshot(),
                         "shown": sorted(m.get("specialWorkspace", {}).get("name")
                             for m in self.system.monitors() if m.get("specialWorkspace", {}).get("name")),
                         "stage": "prepared"}
                journaled = False
                try:
                    with self.system.ipc() as ipc:
                        self.owner(ipc)
                        self.guard(state, ipc, fault=True)
                        expected = self.child.proc
                        self.save(state)
                        journaled = True
                        self.owner(ipc)  # Final preview/ownership check after journaling.
                        # No further requests use this old connection.
                    self.handoff_incomplete = True
                    self.stopping_child = expected
                    self.child.handoff_stop(expected)
                    if (self.system.runtime / "hyprmoncfgd.sock").exists():
                        raise ValueError("old daemon socket persists; no recovery mutation")
                    self.guard(state, fault=True)
                    state["stage"] = "backup"
                    self.save(state)  # Persist uncertain create ownership first.
                    self.system.command("output", "create", "headless", state["output"])
                    self.converge(state, lambda ms: any(m["name"] == state["output"]
                        and m.get("disabled") is False for m in ms))
                    migrate_workspaces(state["output"], lambda: self.guard(state))
                    self.guard(state)
                    if not receiver_handshake([m for m in self.system.monitors()
                                               if m["name"] != state["output"]],
                                              profiles, self.system.ha(), self.system.tv_edid()):
                        raise ValueError("fault evidence changed before connector off")
                    if self.coordinator.clock() > self.deadline:
                        raise TimeoutError("bounded HDMI deadline exceeded before off")
                    state["stage"] = "detect-pending"
                    self.save(state)
                    try:
                        helper.off()
                    except ConnectorRefused:
                        state["stage"] = "backup"
                        self.save(state)
                        raise
                    self.converge(state, lambda ms: all(m["name"] != TV_OUTPUT for m in ms))
                    helper.detect()
                    state["stage"] = "restore"
                    self.save(state)
                finally:
                    helper_cleanup_complete = False
                    try:
                        # Even a cleanup exception must reach compensation and
                        # the owned-child/watcher restoration below.
                        helper.__exit__(None, None, None)
                        helper_cleanup_complete = True
                    finally:
                        if journaled:
                            try:
                                if helper.refused and state["stage"] == "detect-pending":
                                    state["stage"] = "backup"
                                    self.save(state)
                                elif helper.detected:
                                    state["stage"] = "restore"
                                    self.save(state)
                                if state["stage"] == "backup":
                                    self.restore_before_off(state)
                            finally:
                                self.restart_owned()
                                if helper_cleanup_complete and state["stage"] in ("prepared", "compensated"):
                                    if any(m["name"] == state["output"] for m in self.system.monitors()):
                                        raise ValueError("backup still present after ownership restoration")
                                    self.path.unlink()
                self.restore(state)
        self.coordinator.health, self.coordinator.error = "HDMI identity recovered", None
        self.coordinator.last_action = "connector off/detect; verified tv-game"


class Child:
    def __init__(self, spawn=subprocess.Popen):
        self.spawn, self.proc = spawn, None

    def start(self):
        if self.proc is None:
            self.proc = self.spawn([str(Path.home() / ".local/libexec/display-controller/hyprmoncfgd"),
                                    "--ipc-only"])

    def handoff_stop(self, expected):
        if expected is None or self.proc is not expected or expected.poll() is not None:
            raise ValueError("owned child changed before handoff")
        expected.terminate()
        # A failed stop retains this exact handle, never an external replacement.
        expected.wait(timeout=8)
        self.proc = None

    def stop(self):
        if self.proc is not None:
            if self.proc.poll() is None:
                self.proc.terminate()
                try:
                    self.proc.wait(timeout=8)
                except subprocess.TimeoutExpired:
                    self.proc.kill()
                    self.proc.wait(timeout=2)
            else:
                self.proc.wait(timeout=2)


def startup(system, coordinator):
    """Wait only for the private daemon's read-only capability handshake."""
    deadline = coordinator.clock() + 15
    while coordinator.clock() < deadline:
        try:
            with system.ipc(timeout=min(3, deadline - coordinator.clock())) as ipc:
                daemon = ipc.request("status")["daemon"]
                if coordinator.clock() >= deadline:
                    break
                require_ipc_only(daemon)
                coordinator.daemon_ready = True
                coordinator.health = "ready; policy deferred"
                return
        except OSError:
            # Socket creation and initial status may lag child start.
            if coordinator.clock() >= deadline:
                break
            system.wait(min(0.25, deadline - coordinator.clock()))
    raise TimeoutError("startup IPC readiness timeout")


def supervise(system, coordinator, child, publish):
    cleanup_checked = False
    try:
        while not system.stop.is_set():
            if child.proc is None:
                child.start()
                if child.proc is not None and child.proc.poll() is None:
                    try:
                        startup(system, coordinator)
                        if getattr(system, "watcher_holds", None) is not None:
                            with system.ipc() as ipc:
                                Rediscovery(system, child, coordinator).peer(ipc)
                                require_ipc_only(ipc.request("status")["daemon"])
                            system.verify_watcher_claim()
                            system.watcher_holds.close()
                            system.watcher_holds = None
                    except ERRORS as exc:
                        coordinator.error = "startup: " + str(exc)
                        raise
            if child.proc is not None:
                if child.proc.poll() is not None:
                    coordinator.health, coordinator.error = "stopped", "hyprmoncfgd exited"
                    publish(coordinator.status(child.proc.pid))
                    raise ChildProcessError("hyprmoncfgd exited unexpectedly")
                if not cleanup_checked:
                    cleanup_checked = True
                    if system.recovery_pending():
                        coordinator.receiver_attempted = True
                        coordinator.receiver_last_attempt = coordinator.clock()
                        try:
                            Rediscovery(system, child, coordinator).resume()
                        except ERRORS as exc:
                            coordinator.health, coordinator.error = "HDMI recovery journal pending", str(exc)
                coordinator.step()
                if coordinator.rediscovery_request is not None:
                    profiles, coordinator.rediscovery_request = coordinator.rediscovery_request, None
                    try:
                        Rediscovery(system, child, coordinator).run(profiles)
                    except ERRORS as exc:
                        coordinator.health, coordinator.error = "HDMI recovery deferred", str(exc)
            publish(coordinator.status(child.proc.pid if child.proc else None))
            system.stop.wait(POLL)
    finally:
        try:
            child.stop()
        finally:
            if getattr(system, "watcher_holds", None) is not None:
                system.watcher_holds.close()
                system.watcher_holds = None
        coordinator.health = "stopped"
        coordinator.daemon_ready = False
        publish(coordinator.status())


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__)
    modes = parser.add_mutually_exclusive_group()
    modes.add_argument("--status", action="store_true", help="print cached coordinator JSON")
    modes.add_argument("--check", action="store_true", help="read-only scanout check: 0 healthy, 1 mismatch, 2 unavailable")
    modes.add_argument("--audio-tv", action="store_true", help="route audio only if the live TV layout is verified")
    modes.add_argument("--audio-desk", action="store_true", help="route audio only if the live desk layout is verified")
    args = parser.parse_args(argv)
    stop = threading.Event()
    if args.check:
        try:
            system = System(None, stop)
            state = check(system.monitors(), system.drm())
        except ERRORS as exc:
            state = {"health": "unavailable", "error": str(exc)}
        print(json.dumps(state))
        return {"healthy": 0, "mismatch": 1}.get(state["health"], 2)
    try:
        runtime = runtime_dir()
        if args.status:
            print(json.dumps(json.loads((runtime / "display-controller-status.json").read_text())))
            return 0
        if args.audio_tv or args.audio_desk:
            system = System(runtime, stop)
            coordinator = Coordinator(system)
            with system.ipc() as ipc:
                daemon = ipc.request("status")["daemon"]
                require_ipc_only(daemon)
                if not daemon.get("preview") and not daemon.get("unmanaged"):
                    editor = normalize_editor(ipc.request("editor_state"), daemon)
                    profiles = {p["name"]: p for p in editor["profiles"]
                                if p["name"] in ("desk", "tv-game", "tv-recovery")}
                    coordinator.reconcile_audio(editor, profiles, system.monitors(),
                                                "tv-game" if args.audio_tv else "desk")
            print(json.dumps({"audio_health": coordinator.audio_health,
                              "audio_error": coordinator.audio_error}))
            return 0 if coordinator.audio_health == "healthy" else 2
        with coordinator_lock(runtime):
            for sig in (signal.SIGTERM, signal.SIGINT):
                signal.signal(sig, lambda *_: stop.set())
            system = System(runtime, stop)
            coordinator = Coordinator(system)

            def publish(state):
                atomic_write(runtime / "display-controller-status.json", json.dumps(state) + "\n")
                if state["selected_route"]:
                    atomic_write(runtime / "ha-display-profile", state["selected_route"] + "\n")

            supervise(system, coordinator, Child(), publish)
        return 0
    except ERRORS as exc:
        print(json.dumps({"health": "unavailable", "error": str(exc)}))
        return 2


if __name__ == "__main__":
    raise SystemExit(main())
