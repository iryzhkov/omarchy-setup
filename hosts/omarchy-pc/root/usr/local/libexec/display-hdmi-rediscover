#!/usr/bin/python3 -I
"""Fixed-purpose NVIDIA HDMI identity rediscovery. No user code or configuration."""
import contextlib
import fcntl
import json
import os
from pathlib import Path
import re
import select
import signal
import stat
import sys

IDENTITY = {"make": "Sony", "model": "SONY TV  *30", "serial": "0x01010101"}


class Kernel:
    def connector(self):
        cards = [p for p in Path("/sys/class/drm").glob("card*")
                 if re.fullmatch(r"card[0-9]+", p.name)
                 and (p / "device/vendor").read_text().strip() == "0x10de"]
        if len(cards) != 1:
            raise ValueError("NVIDIA GPU absent or ambiguous")
        connectors = list(cards[0].parent.glob(cards[0].name + "-HDMI-A-*"))
        if len(connectors) != 1 or connectors[0].name != cards[0].name + "-HDMI-A-1":
            raise ValueError("NVIDIA HDMI connector absent or ambiguous")
        return connectors[0]

    def status(self, connector):
        return (connector / "status").read_text().strip()

    def edid(self, connector):
        with (connector / "edid").open("rb") as stream:
            return stream.read(4097)

    def write(self, connector, value):
        with (connector / "status").open("w") as stream:
            stream.write(value + "\n")

    def wait(self, stream, timeout=8):
        if not select.select([stream], [], [], timeout)[0]:
            raise TimeoutError("controller handshake timeout")
        return stream.readline(32)


def identity(data):
    if (len(data) < 128 or len(data) > 4096
            or data[:10] != b"\x00\xff\xff\xff\xff\xff\xff\x00\x4d\xd9"
            or len(data) != 128 * (1 + data[126])
            or any(sum(data[i:i + 128]) % 256 for i in range(0, len(data), 128))):
        raise ValueError("invalid Sony TV EDID")
    names = []
    for offset in range(54, 126, 18):
        descriptor = data[offset:offset + 18]
        if descriptor[:5] == b"\x00\x00\x00\xfc\x00":
            names.append(descriptor[5:18].decode("ascii").strip())
    result = {"make": "Sony", "model": names[0] if len(names) == 1 else "",
              "serial": "0x" + format(int.from_bytes(data[12:16], "little"), "08X")}
    if result != IDENTITY:
        raise ValueError("kernel EDID is not the qualified TV")
    return result


def qualified(kernel, connector):
    if kernel.status(connector) != "connected":
        raise ValueError("HDMI is not connected")
    return identity(kernel.edid(connector))


def rediscover(kernel, stream, emit):
    connector = kernel.connector()
    qualified(kernel, connector)
    emit("ready")
    if kernel.wait(stream, timeout=30) != "off\n":
        raise ValueError("missing off handshake")
    # Recheck immediately before off. An uncertain write still requires detect.
    qualified(kernel, connector)
    try:
        kernel.write(connector, "off")
        if kernel.status(connector) != "disconnected":
            raise ValueError("logical disconnect not observed")
        emit("disconnected")
        if kernel.wait(stream) != "detect\n":
            raise ValueError("missing detect handshake")
    finally:
        # SIGTERM/INT, EOF, timeout and failed off all pass through here.
        # systemd and sudo can both deliver TERM. A second cancellation must
        # not interrupt the compensating write or its acknowledgement.
        previous = {sig: signal.signal(sig, signal.SIG_IGN)
                    for sig in (signal.SIGTERM, signal.SIGINT, signal.SIGHUP)}
        try:
            kernel.write(connector, "detect")
            emit("detect-restored")
        finally:
            for sig, handler in previous.items():
                signal.signal(sig, handler)


def main(argv=None):
    args = sys.argv[1:] if argv is None else argv
    if args not in (["--check"], ["--rediscover"], ["--detect"]):
        raise ValueError("expected --check, --rediscover or --detect")
    if os.geteuid() != 0:
        raise PermissionError("root required")
    fd = os.open("/run/lock/display-hdmi-rediscover.lock",
                 os.O_CREAT | os.O_RDWR | os.O_CLOEXEC | os.O_NOFOLLOW, 0o600)
    try:
        info = os.fstat(fd)
        if (not stat.S_ISREG(info.st_mode) or info.st_uid != 0
                or info.st_nlink != 1 or info.st_mode & 0o077):
            raise ValueError("unsafe root lock")
        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        kernel = Kernel()
        if args == ["--check"]:
            print(json.dumps(qualified(kernel, kernel.connector())))
        elif args == ["--detect"]:
            # Compensation is safe even when off has removed the EDID.
            kernel.write(kernel.connector(), "detect")
            print("detect-restored", flush=True)
        else:
            def interrupted(*_):
                raise InterruptedError("connector recovery cancelled")
            for sig in (signal.SIGTERM, signal.SIGINT, signal.SIGHUP):
                signal.signal(sig, interrupted)
            rediscover(kernel, sys.stdin, lambda value: print(value, flush=True))
    finally:
        os.close(fd)


if __name__ == "__main__":
    try:
        main()
    except (OSError, ValueError, UnicodeError) as exc:
        print("HDMI recovery incomplete: " + str(exc), file=sys.stderr)
        raise SystemExit(2)
