[Unit]
Description=Follow the newest compatible T3 Code and t3-steward pair
Documentation=https://github.com/iryzhkov/omarchy-setup

[Service]
Type=oneshot
# npm comes from a mise shim and the steward lives in ~/.local/bin; a user unit
# inherits neither from a login shell.
Environment=PATH=%h/.local/share/mise/shims:%h/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=HOME=%h
# Pulls the checkout, then runs modules/common/26-t3.sh directly: this host is
# Debian, so run.sh -- which requires Omarchy -- cannot drive the module here,
# and there is no `omarchy update` to carry it in through the post-update hook.
ExecStart=%h/.local/share/omarchy-setup/bin/t3-update

[Install]
WantedBy=default.target
