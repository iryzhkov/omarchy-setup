[Unit]
Description=Daily check for a newer T3 Code and t3-steward pair

[Timer]
# Morning, after the overnight backups and the 08:30 drift check have had their
# say. The pair moves rarely, so this is a cheap two-request check most days.
OnCalendar=*-*-* 09:15
# The host is a VM that occasionally reboots; run a missed check on the way up.
Persistent=true
RandomizedDelaySec=20m

[Install]
WantedBy=timers.target
